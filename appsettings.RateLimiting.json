{
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "GeneralRules": [
            {
                "Endpoint": "POST:/Account/Login",
                "Period": "1m",
                "Limit": 5
            },
            {
                "Endpoint": "POST:/Account/Register",
                "Period": "1h",
                "Limit": 3
            },
            {
                "Endpoint": "POST:/Checkout/PlaceOrder",
                "Period": "1m",
                "Limit": 10
            },
            {
                "Endpoint": "*",
                "Period": "1s",
                "Limit": 100
            },
            {
                "Endpoint": "*",
                "Period": "1m",
                "Limit": 500
            }
        ],
        "EndpointWhitelist": [
            "get:/css/*",
            "get:/js/*",
            "get:/admin/*",
            "get:/uploads/*",
            "get:/images/*",
            "get:/lib/*",
            "get:/vendor/*"
        ]
    }
}