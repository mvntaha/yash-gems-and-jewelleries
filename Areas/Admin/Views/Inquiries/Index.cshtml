@model Yash_Gems___Jewelleries.ViewModels.InquiryIndexViewModel
@{
    ViewData["Title"] = "Customer Inquiries";
}

<!-- Start Container Fluid -->
<div class="container-xxl">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="d-flex card-header justify-content-between align-items-center">
                    <div>
                        <h4 class="card-title">All Inquiries List</h4>
                    </div>
                    <div class="d-flex gap-2">
                        <form asp-action="Index" method="get" class="d-flex gap-2">
                            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search..." value="@Model.Search">
                            <div class="dropdown">
                              <a href="#" class="dropdown-toggle btn btn-sm btn-outline-light" data-bs-toggle="dropdown" aria-expanded="false">
                                   @(ViewBag.IsActive == true ? "Active" : ViewBag.IsActive == false ? "Inactive" : "Status")
                              </a>
                              <div class="dropdown-menu dropdown-menu-end">
                                  <a class="dropdown-item" href="@Url.Action("Index", "Inquiry", new { area = "Admin", searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId })">All Status</a>
                                   <a class="dropdown-item" href="@Url.Action("Index", "Inquiry", new { area = "Admin", isActive = true, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId })">Active</a>
                                   <a class="dropdown-item" href="@Url.Action("Index", "Inquiry", new { area = "Admin", isActive = false, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId })">Inactive</a>
                              </div>
                         </div>
                        </form>
                    </div>
                </div>

                <div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 table-hover table-centered">
                            <thead class="bg-light-subtle">
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Subject</th>
                                    <th>Message</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Inquiries != null && Model.Inquiries.Any())
                                {
                                    @foreach (var item in Model.Inquiries)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded bg-light avatar-md d-flex align-items-center justify-content-center">
                                                        <img src="@(string.IsNullOrEmpty(item.ProfilePictureUrl) ? "/uploads/dummy-user.jpg" : (item.ProfilePictureUrl.StartsWith("/") ? item.ProfilePictureUrl : "/" + item.ProfilePictureUrl))" alt="@item.CustomerName" class="avatar-md">
                                                    </div>
                                                    <div>
                                                        <a href="javascript:void(0);" class="text-dark fw-medium fs-15 btn-reply-modal" data-id="@item.InquiryId">@item.CustomerName</a>
                                                        <p class="text-muted mb-0 mt-1 fs-13">@item.CustomerEmail</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-body">@item.Subject</span>
                                            </td>
                                            <td>
                                                <span class="text-body">@(item.OriginalMessage != null && item.OriginalMessage.Length > 50 ? item.OriginalMessage.Substring(0, 47) + "..." : item.OriginalMessage ?? "N/A")</span>
                                            </td>
                                            <td>
                                                @item.Date.ToString("dd MMM, yyyy")
                                                <p class="text-muted mb-0 fs-12">@item.Date.ToString("hh:mm tt")</p>
                                            </td>
                                            <td>
                                                @if (item.Status == "New" || item.Status == "InProgress" || item.Status == "Active")
                                                {
                                                    <span class="badge border border-warning text-warning px-2 py-1 fs-13">@item.Status</span>
                                                }
                                                else if (item.Status == "Resolved")
                                                {
                                                    <span class="badge border border-success text-success px-2 py-1 fs-13">@item.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge border border-danger text-danger px-2 py-1 fs-13">@item.Status</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex gap-2 justify-content-end">
                                                    <button type="button" class="btn btn-soft-secondary btn-sm btn-status-toggle" data-id="@item.InquiryId" title="Toggle Status">
                                                        <iconify-icon icon="@(item.Status == "Closed" ? "solar:eye-closed-broken" : "solar:eye-broken")" class="align-middle fs-18"></iconify-icon>
                                                    </button>
                                                    <button type="button" class="btn btn-soft-primary btn-sm btn-reply-modal" data-id="@item.InquiryId" title="View & Respond">
                                                        <iconify-icon icon="solar:chat-round-dots-broken" class="align-middle fs-18"></iconify-icon>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4">
                                            <p class="text-muted mb-0">No inquiries found matching your criteria.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer border-top">
                        <nav aria-label="Page navigation example">
                            <ul class="pagination justify-content-end mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.Search, isActive = Model.IsActive })">Previous</a>
                                </li>

                                @{
                                    int maxPagesToShow = 5;
                                    int startPage = Math.Max(1, Model.CurrentPage - (maxPagesToShow / 2));
                                    int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);

                                    if (endPage - startPage + 1 < maxPagesToShow)
                                    {
                                        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = 1, search = Model.Search, isActive = Model.IsActive })">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.Search, isActive = Model.IsActive })">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    @if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, search = Model.Search, isActive = Model.IsActive })">@Model.TotalPages</a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.Search, isActive = Model.IsActive })">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Placeholder -->
<div class="modal fade" id="replyModal" tabindex="-1" aria-labelledby="replyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="replyModalContent">
            <!-- Content loaded via AJAX -->
             <div class="modal-body text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // CSRF Token Setup for AJAX
            var token = $('input[name="__RequestVerificationToken"]').val();
            
            // Open Reply Modal
            $(document).on('click', '.btn-reply-modal', function () {
                var id = $(this).data('id');
                var url = '@Url.Action("GetReplyModal", "Inquiries", new { area = "Admin" })/' + id;
                
                $('#replyModalContent').html('<div class="modal-body text-center p-5"><div class="spinner-border text-primary" role="status"></div></div>');
                $('#replyModal').modal('show');
                $('#replyModalContent').load(url, function(response, status, xhr) {
                    if (status == "error") {
                        $('#replyModalContent').html('<div class="p-4 text-center text-danger">Error loading form: ' + xhr.status + " " + xhr.statusText + '</div>');
                    }
                });
            });

            // Handle Reply Form Submission
            $(document).on('submit', '#replyForm', function (e) {
                e.preventDefault();
                var form = $(this);
                
                if (!form.valid()) return false;

                var btn = $('#btnSendReply');
                var spinner = $('#replySpinner');
                var text = $('#replyText');

                btn.prop('disabled', true);
                spinner.removeClass('d-none');
                text.text('Processing...');

                $.ajax({
                    type: "POST",
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function (res) {
                        AdminPanel.handleResponse(res, function() {
                            $('#replyModal').modal('hide');
                            location.reload();
                        });
                    },
                    error: function () {
                        AdminPanel.showToast('An unexpected error occurred.', 'danger');
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                        spinner.addClass('d-none');
                        text.text('Send Response');
                    }
                });
            });

            // Toggle Status
            $(document).on('click', '.btn-status-toggle', function () {
                var id = $(this).data('id');
                
                AdminPanel.confirmAction({
                    title: 'Are you sure?',
                    text: "You want to toggle the status of this inquiry?",
                }, function() {
                    $.post('@Url.Action("ToggleStatus", "Inquiries", new { area = "Admin" })', { id: id, __RequestVerificationToken: token }, function(res) {
                        AdminPanel.handleResponse(res, function() {
                            location.reload();
                        });
                    });
                });
            });
        });
    </script>
}
