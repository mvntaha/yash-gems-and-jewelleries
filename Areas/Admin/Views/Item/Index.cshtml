@model IEnumerable<Yash_Gems___Jewelleries.Models.Item>
@{
    ViewData["Title"] = "Products";
    int totalPages = ViewBag.TotalPages ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
}

<!-- Start Container Fluid -->
<div class="container-fluid">
     @Html.AntiForgeryToken()
     <partial name="_Notifications" />
     <div class="row">
          <div class="col-xl-12">
               <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center gap-1">
                         <h4 class="card-title flex-grow-1">All Product List</h4>

                         <div class="dropdown">
                              <a href="#" class="dropdown-toggle btn btn-sm btn-outline-light" data-bs-toggle="dropdown" aria-expanded="false">
                                   @(ViewBag.CategoryId != null 
                                       ? ((IEnumerable<Yash_Gems___Jewelleries.Models.Masters.Category>)ViewBag.Categories)?.FirstOrDefault(c => c.CategoryId == ViewBag.CategoryId)?.CategoryName ?? "Categories" 
                                       : "Categories")
                              </a>
                              <div class="dropdown-menu dropdown-menu-end">
                                  <a class="dropdown-item" href="@Url.Action("Index", "Item", new { area = "Admin", searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, isActive = ViewBag.IsActive })">All Categories</a>
                                  @if (ViewBag.Categories != null)
                                  {
                                   foreach (var category in (IEnumerable<Yash_Gems___Jewelleries.Models.Masters.Category>)ViewBag.Categories)
                                   {
                                        <a class="dropdown-item" href="@Url.Action("Index", "Item", new { area = "Admin", categoryId = category.CategoryId, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, isActive = ViewBag.IsActive })">@category.CategoryName</a>
                                   }
                                  }
                              </div>
                         </div>

                         <div class="dropdown">
                              <a href="#" class="dropdown-toggle btn btn-sm btn-outline-light" data-bs-toggle="dropdown" aria-expanded="false">
                                   @(ViewBag.IsActive == true ? "Active" : ViewBag.IsActive == false ? "Inactive" : "Status")
                              </a>
                              <div class="dropdown-menu dropdown-menu-end">
                                  <a class="dropdown-item" href="@Url.Action("Index", "Item", new { area = "Admin", searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId })">All Status</a>
                                   <a class="dropdown-item" href="@Url.Action("Index", "Item", new { area = "Admin", isActive = true, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId })">Active</a>
                                   <a class="dropdown-item" href="@Url.Action("Index", "Item", new { area = "Admin", isActive = false, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId })">Inactive</a>
                              </div>
                         </div>

                          <a href="@Url.Action("Add", "Item", new { area = "Admin" })" class="btn btn-sm btn-primary">
                              Add Product
                         </a>
                    </div>

                    <div>
                         <div class="table-responsive">
                              <table class="table align-middle mb-0 table-hover table-centered">
                                   <thead class="bg-light-subtle">
                                        <tr>
                                             <th>Product Info</th>
                                             <th>Price</th>
                                             <th>Discount</th>
                                             <th>Stock</th>
                                             <th>Category</th>
                                             <th>Status</th>
                                             <th>Action</th>
                                        </tr>
                                   </thead>
                                   <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                             @foreach (var item in Model)
                                             {
                                                  <tr>
                                                       <td>
                                                            <div class="d-flex align-items-center gap-2">
                                                                 <div class="rounded bg-light avatar-md d-flex align-items-center justify-content-center">
                                                                      <img src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/uploads/default.png" : (item.PrimaryImageUrl.StartsWith("/") ? item.PrimaryImageUrl : "/" + item.PrimaryImageUrl))" alt="@item.ItemName" class="avatar-md">
                                                                 </div>
                                                                 <div>
                                                                      <a href="@Url.Action("Detail", "Item", new { area = "Admin", id = item.StyleCode })" class="text-dark fw-medium fs-15">@item.ItemName</a>
                                                                      <p class="text-muted mb-0 mt-1 fs-13"><span>Type : </span>@item.ProductType?.ProductTypeName</p>
                                                                 </div>
                                                            </div>
                                                       </td>
                                                       <td>@item.SellingPrice.ToString("C")</td>
                                                       <td>@item.DiscountPercentage.ToString("C")</td>
                                                       <td>
                                                            <p class="mb-1 text-muted"><span class="text-dark fw-medium">@item.Quantity Item</span> Left</p>
                                                            <p class="mb-0 text-muted">@item.OrderItems.Sum(oi => oi.Quantity) Sold</p>
                                                       </td>
                                                        <td>@item.Category?.CategoryName</td>
                                                        <td>
                                                             @if (item.IsActive)
                                                             {
                                                                  <span class="badge border border-success text-success px-2 py-1 fs-13">Active</span>
                                                             }
                                                             else
                                                             {
                                                                  <span class="badge border border-danger text-danger px-2 py-1 fs-13">Inactive</span>
                                                             }
                                                        </td>
                                                        <td>
                                                             <div class="d-flex gap-2">
                                                                  <button type="button" 
                                                                          onclick="toggleItemStatus('@item.StyleCode', this)" 
                                                                          class="btn btn-light btn-sm status-toggle-btn" 
                                                                          title="Toggle Status">
                                                                       <iconify-icon icon="@(item.IsActive ? "solar:eye-broken" : "solar:eye-closed-broken")" 
                                                                                     class="align-middle fs-18 text-secondary"></iconify-icon>
                                                                  </button>
                                                                  <a href="@Url.Action("Edit", "Item", new { area = "Admin", id = item.StyleCode })" class="btn btn-soft-primary btn-sm" title="Edit Product"><iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon></a>
                                                                  <button type="button" onclick="deleteItem('@item.StyleCode', this)" class="btn btn-soft-danger btn-sm" title="Delete Product">
                                                                       <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                                  </button>
                                                             </div>
                                                        </td>
                                                  </tr>
                                             }
                                        }
                                        else
                                        {
                                             <tr>
                                                  <td colspan="7" class="text-center p-4">
                                                       <div class="text-muted">No products found.</div>
                                                  </td>
                                             </tr>
                                        }
                                   </tbody>
                              </table>
                         </div>
                         <!-- end table-responsive -->
                    </div>
                    @if (totalPages > 1)
                    {
                        <div class="card-footer border-top">
                             <nav aria-label="Page navigation example">
                                  <ul class="pagination justify-content-end mb-0">
                                       <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = currentPage - 1, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">Previous</a>
                                       </li>
                                       
                                       @{
                                            int maxPagesToShow = 5;
                                            int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
                                            int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);
                                            
                                            if (endPage - startPage + 1 < maxPagesToShow)
                                            {
                                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                            }
                                            startPage = Math.Max(1, startPage);
                                       }

                                       @if (startPage > 1)
                                       {
                                            <li class="page-item">
                                                 <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = 1, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">1</a>
                                            </li>
                                            @if (startPage > 2)
                                            {
                                                 <li class="page-item disabled"><span class="page-link">...</span></li>
                                            }
                                       }

                                       @for (int i = startPage; i <= endPage; i++)
                                       {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                 <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = i, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">@i</a>
                                            </li>
                                       }

                                       @if (endPage < totalPages)
                                       {
                                            @if (endPage < totalPages - 1)
                                            {
                                                 <li class="page-item disabled"><span class="page-link">...</span></li>
                                            }
                                            <li class="page-item">
                                                 <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = totalPages, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">@totalPages</a>
                                            </li>
                                       }

                                       <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = currentPage + 1, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">Next</a>
                                       </li>
                                  </ul>
                             </nav>
                        </div>
                    }
               </div>
          </div>

     </div>
</div>
<!-- End Container Fluid -->

@section Scripts {
    <script>
        function toggleItemStatus(styleCode, btn) {
            const $btn = $(btn);
            const $icon = $btn.find('iconify-icon');
            const $row = $btn.closest('tr');
            const $badge = $row.find('.status-badge');
            
            $btn.prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("ToggleStatus", "Item", new { area = "Admin" })',
                type: 'POST',
                data: { 
                    id: styleCode,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    AdminPanel.handleResponse(response, function() {
                        if (response.success_toggle) {
                            $icon.attr('icon', 'solar:eye-broken').addClass('text-secondary').removeClass('text-muted');
                            $badge.removeClass('bg-danger-subtle text-danger').addClass('bg-secondary-subtle text-secondary').text('Active');
                        } else {
                            $icon.attr('icon', 'solar:eye-closed-broken').addClass('text-muted').removeClass('text-secondary');
                            $badge.removeClass('bg-secondary-subtle text-secondary').addClass('bg-danger-subtle text-danger').text('Inactive');
                        }
                    });
                },
                error: function (xhr) {
                    AdminPanel.showToast('Error: ' + (xhr.responseJSON?.message || 'Failed to update status'), 'danger');
                },
                complete: function() {
                    $btn.prop('disabled', false);
                }
            });
        }

        function deleteItem(styleCode, btn) {
            AdminPanel.confirmAction({
                text: "This product will be permanently deleted!",
                confirmButtonText: 'Yes, delete it!'
            }, function() {
                $.post('@Url.Action("Delete", "Item", new { area = "Admin" })', { 
                    id: styleCode, 
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
                }, function(response) {
                    AdminPanel.handleResponse(response, function() {
                        location.reload();
                    });
                }).fail(function() {
                    AdminPanel.showToast("Failed to delete product.", "danger");
                });
            });
        }
    </script>
}