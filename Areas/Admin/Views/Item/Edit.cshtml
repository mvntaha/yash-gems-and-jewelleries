@model Yash_Gems___Jewelleries.ViewModels.ItemEditViewModel
@{
    ViewData["Title"] = "Edit Item";
}

<!-- Start Container Fluid -->
<div class="container-xxl">
    <partial name="_Notifications" />
    <form asp-area="Admin" asp-action="Edit" asp-controller="Item" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StyleCode" />
        <div class="row">
        <div class="col-xl-3 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <img src="@(string.IsNullOrEmpty(Model.ExistingPrimaryImageUrl) ? "/uploads/default.png" : (Model.ExistingPrimaryImageUrl.StartsWith("/") ? Model.ExistingPrimaryImageUrl : "/" + Model.ExistingPrimaryImageUrl))" alt="" class="img-fluid rounded bg-light" id="preview-primary">
                        <div class="mt-3">
                            <h4>@Model.ItemName Preview</h4>
                            <div class="mt-3">
                                <h5 class="text-dark fw-medium">Upload New Images :</h5>
                                <div class="mb-2">
                                    <label class="form-label fs-13 text-muted">Primary Image</label>
                                    <input type="file" name="NewPrimaryImage" class="form-control form-control-sm" onchange="document.getElementById('preview-primary').src = window.URL.createObjectURL(this.files[0])">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label fs-13 text-muted">Secondary Image</label>
                                    <input type="file" name="NewSecondaryImage" class="form-control form-control-sm">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label fs-13 text-muted">Tertiary Image</label>
                                    <input type="file" name="NewTertiaryImage" class="form-control form-control-sm">
                                </div>
                                @if(!string.IsNullOrEmpty(Model.ExistingSecondaryImageUrl) || !string.IsNullOrEmpty(Model.ExistingTertiaryImageUrl))
                                {
                                    <h5 class="text-dark fw-medium mt-3">Additional Images :</h5>
                                    <div class="d-flex gap-2">
                                            @{
                                                var secondImg = Model.ExistingSecondaryImageUrl;
                                                var secondImgUrl = string.IsNullOrEmpty(secondImg) ? "/uploads/default.png" : (secondImg.StartsWith("/") ? secondImg : "/" + secondImg);
                                                var thirdImg = Model.ExistingTertiaryImageUrl;
                                                var thirdImgUrl = string.IsNullOrEmpty(thirdImg) ? "/uploads/default.png" : (thirdImg.StartsWith("/") ? thirdImg : "/" + thirdImg);
                                            }
                                            <img src="@secondImgUrl" alt="" class="img-fluid rounded bg-light" style="width: 60px;">
                                            <img src="@thirdImgUrl" alt="" class="img-fluid rounded bg-light" style="width: 60px;">
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-9 col-lg-8 ">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Product Information</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label asp-for="ItemName" class="form-label">Product Name</label>
                                    <input asp-for="ItemName" class="form-control" placeholder="Items Name">
                                    <span asp-validation-for="ItemName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="CategoryId" class="form-control-label">Product Categories</label>
                                <select asp-for="CategoryId" class="form-control form-control-sm" asp-items="ViewBag.CategoryList" required>
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="BrandId" class="form-label">Brand</label>
                                    <select asp-for="BrandId" class="form-control form-control-sm" asp-items="ViewBag.BrandList" required>
                                        <option value="">Select</option>
                                    </select>
                                    <span asp-validation-for="BrandId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="ProductTypeId" class="form-label">Product Type</label>
                                    <select asp-for="ProductTypeId" class="form-control form-control-sm" asp-items="ViewBag.ProductTypeList" required>
                                        <option value="">Select</option>
                                    </select>
                                    <span asp-validation-for="ProductTypeId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="GoldTypeId" class="form-label">Gold Karat</label>
                                    <select asp-for="GoldTypeId" class="form-control form-control-sm" asp-items="ViewBag.GoldKaratList" required>
                                        <option value="">Select</option>
                                    </select>
                                    <span asp-validation-for="GoldTypeId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="GoldWeight" class="form-label">Gold Weight (gm)</label>
                                    <input asp-for="GoldWeight" type="number" step="0.001" min="0.001" max="10000" class="form-control" placeholder="0.000">
                                    <span asp-validation-for="GoldWeight" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="GoldRate" class="form-label">Gold Rate (per gm)</label>
                                    <input asp-for="GoldRate" type="number" step="0.01" class="form-control" placeholder="0.00">
                                    <span asp-validation-for="GoldRate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="WastagePercentage" class="form-label">Wastage %</label>
                                    <input asp-for="WastagePercentage" type="number" step="0.01" class="form-control" placeholder="0.00">
                                    <span asp-validation-for="WastagePercentage" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label">Description</label>
                                    <textarea asp-for="Description" class="form-control bg-light-subtle" rows="4" placeholder="Short description about the product"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label class="form-label">Style Code (Handled by System)</label>
                                    <input class="form-control" value="@Model.StyleCode" readonly>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label">Stock Quantity</label>
                                    <input asp-for="Quantity" type="number" class="form-control" placeholder="0">
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="Pairs" class="form-label">Pairs</label>
                                    <input asp-for="Pairs" type="number" class="form-control" placeholder="1">
                                    <span asp-validation-for="Pairs" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                <label asp-for="CertificateId" class="form-label">Certificate</label>
                                <select asp-for="CertificateId" class="form-control form-control-sm" asp-items="ViewBag.CertificateList">
                                    <option value="">No Certificate / Select</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Diamond Details -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title">Diamond Details</h4>
                        <button type="button" class="btn btn-sm btn-primary" id="add-diamond">Add Diamond</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0 table-hover table-centered" id="diamond-table">
                                <thead class="bg-light-subtle">
                                    <tr>
                                        <th>Quality</th>
                                        <th>Carat</th>
                                        <th>Pieces</th>
                                        <th>Weight(g)</th>
                                        <th>Rate</th>
                                        <th>Shape</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="diamond-body">
                                    @if (Model.DiamondDetails != null)
                                    {
                                        for (int i = 0; i < Model.DiamondDetails.Count; i++)
                                        {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="DiamondDetails[i].DiamondDetailId" />
                                                <input type="hidden" asp-for="DiamondDetails[i].IsDeleted" class="delete-flag" />
                                                <select asp-for="DiamondDetails[i].DiamondQualityId" class="form-control form-control-sm" asp-items="ViewBag.DiamondQualityList" required>
                                                    <option value="">Select</option>
                                                </select>
                                            </td>
                                            <td><input asp-for="DiamondDetails[i].Carat" type="number" step="0.001" class="form-control form-control-sm" required></td>
                                            <td><input asp-for="DiamondDetails[i].Pieces" type="number" class="form-control form-control-sm" required></td>
                                            <td><input asp-for="DiamondDetails[i].Weight" type="number" step="0.001" class="form-control form-control-sm" required></td>
                                            <td><input asp-for="DiamondDetails[i].Rate" type="number" step="0.01" class="form-control form-control-sm" required></td>
                                            <td><input asp-for="DiamondDetails[i].Shape" type="text" class="form-control form-control-sm"></td>
                                            <td><button type="button" class="existing-remove-row btn btn-soft-danger btn-sm"><i class="bx bx-trash"></i></button></td>
                                        </tr>
                                        }
                                    }
                                    <tr id="no-diamond-row" style="@(Model.DiamondDetails != null && Model.DiamondDetails.Any() ? "display:none" : "")">
                                        <td colspan="7" class="text-center py-4">
                                            <p class="text-muted mb-0">No diamonds found.</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Stone Details -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title">Stone Details</h4>
                        <button type="button" class="btn btn-sm btn-primary" id="add-stone">Add Stone</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0 table-hover table-centered" id="stone-table">
                                <thead class="bg-light-subtle">
                                    <tr>
                                        <th>Quality</th>
                                        <th>Weight(g)</th>
                                        <th>Pieces</th>
                                        <th>Carat</th>
                                        <th>Rate</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="stone-body">
                                    @if (Model.StoneDetails != null)
                                    {
                                        for (int i = 0; i < Model.StoneDetails.Count; i++)
                                        {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="StoneDetails[i].StoneDetailId" />
                                                <input type="hidden" asp-for="StoneDetails[i].IsDeleted" class="delete-flag" />
                                                <select asp-for="StoneDetails[i].StoneQualityId" class="form-control form-control-sm" asp-items="ViewBag.StoneQualityList" required>
                                                    <option value="">Select</option>
                                                </select>
                                            </td>
                                            <td><input asp-for="StoneDetails[i].Weight" type="number" step="0.001" class="form-control form-control-sm" required></td>
                                            <td><input asp-for="StoneDetails[i].Pieces" type="number" class="form-control form-control-sm" required></td>
                                            <td><input asp-for="StoneDetails[i].Carat" type="number" step="0.001" class="form-control form-control-sm"></td>
                                            <td><input asp-for="StoneDetails[i].Rate" type="number" step="0.01" class="form-control form-control-sm" required></td>
                                            <td><button type="button" class="existing-remove-row btn btn-soft-danger btn-sm"><i class="bx bx-trash"></i></button></td>
                                        </tr>
                                        }
                                    }
                                    <tr id="no-stone-row" style="@(Model.StoneDetails != null && Model.StoneDetails.Any() ? "display:none" : "")">
                                        <td colspan="6" class="text-center py-4">
                                            <p class="text-muted mb-0">No stones found.</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Pricing & Charges</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-3">
                                <label asp-for="GoldMakingCharges" class="form-label">Gold Making</label>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class='bx bx-dollar'></i></span>
                                    <input asp-for="GoldMakingCharges" type="number" step="0.01" class="form-control" placeholder="0.00">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <label asp-for="StoneMakingCharges" class="form-label">Stone Making</label>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class='bx bx-dollar'></i></span>
                                    <input asp-for="StoneMakingCharges" type="number" step="0.01" class="form-control" placeholder="0.00">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <label asp-for="OtherMakingCharges" class="form-label">Other Making</label>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class='bx bx-dollar'></i></span>
                                    <input asp-for="OtherMakingCharges" type="number" step="0.01" class="form-control" placeholder="0.00">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <label asp-for="DiscountPercentage" class="form-label">Discount %</label>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class='bx bxs-discount'></i></span>
                                    <input asp-for="DiscountPercentage" type="number" step="0.01" class="form-control" placeholder="0.00">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsFeatured">
                                    <label class="form-check-label" asp-for="IsFeatured">Featured Product</label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsNewLaunch">
                                    <label class="form-check-label" asp-for="IsNewLaunch">New Launch</label>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsOnSale">
                                    <label class="form-check-label" asp-for="IsOnSale">On Sale</label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                    <label class="form-check-label" asp-for="IsActive">Is Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEO Metadata -->
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">SEO Metadata</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="MetaTitle" class="form-label">Meta Title</label>
                            <input asp-for="MetaTitle" class="form-control" placeholder="SEO Title">
                        </div>
                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label">Meta Description</label>
                            <textarea asp-for="MetaDescription" class="form-control" rows="2" placeholder="SEO Description"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label">Meta Keywords</label>
                            <input asp-for="MetaKeywords" class="form-control" placeholder="keyword1, keyword2">
                        </div>
                    </div>
                </div>

                <div class="p-3 bg-light mb-3 rounded">
                    <div class="row justify-content-end g-2">
                        <div class="col-lg-2">
                            <button type="submit" class="btn btn-outline-secondary w-100">Update Product</button>
                        </div>
                        <div class="col-lg-2">
                            <a href="@Url.Action("Index", "Item", new { area = "Admin" })" class="btn btn-primary w-100">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let diamondIndex = @Model.DiamondDetails.Count;
        let stoneIndex = @Model.StoneDetails.Count;

        function toggleNoDataMessage(tableBodyId, noDataRowId) {
            const tbody = document.getElementById(tableBodyId);
            const noDataRow = document.getElementById(noDataRowId);
            
            // Count visible rows
            let visibleRows = 0;
            Array.from(tbody.querySelectorAll('tr')).forEach(row => {
                if (row.id !== noDataRowId && row.style.display !== 'none') {
                    visibleRows++;
                }
            });

            if (visibleRows === 0) {
                noDataRow.style.display = '';
            } else {
                noDataRow.style.display = 'none';
            }
        }

        document.getElementById('add-diamond').addEventListener('click', function() {
            const tbody = document.getElementById('diamond-body');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select name="DiamondDetails[${diamondIndex}].DiamondQualityId" class="form-control form-control-sm" required>
                        <option value="">Select</option>
                        @if (ViewBag.DiamondQualities != null) {
                            foreach(var q in (IEnumerable<Yash_Gems___Jewelleries.Models.Masters.DiamondQuality>)ViewBag.DiamondQualities) {
                                <option value="@q.DiamondQualityId">@q.QualityGrade</option>
                            }
                        }
                    </select>
                </td>
                <td><input name="DiamondDetails[${diamondIndex}].Carat" type="number" step="0.001" class="form-control form-control-sm" required></td>
                <td><input name="DiamondDetails[${diamondIndex}].Pieces" type="number" class="form-control form-control-sm" required></td>
                <td><input name="DiamondDetails[${diamondIndex}].Weight" type="number" step="0.001" class="form-control form-control-sm" required></td>
                <td><input name="DiamondDetails[${diamondIndex}].Rate" type="number" step="0.01" class="form-control form-control-sm" required></td>
                <td><input name="DiamondDetails[${diamondIndex}].Shape" type="text" class="form-control form-control-sm"></td>
                <td><button type="button" class="remove-row btn btn-soft-danger btn-sm"><i class="bx bx-trash"></i></button></td>
            `;
            tbody.insertBefore(tr, document.getElementById('no-diamond-row'));
            diamondIndex++;
            toggleNoDataMessage('diamond-body', 'no-diamond-row');
        });

        document.getElementById('add-stone').addEventListener('click', function() {
            const tbody = document.getElementById('stone-body');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select name="StoneDetails[${stoneIndex}].StoneQualityId" class="form-control form-control-sm" required>
                        <option value="">Select</option>
                        @if (ViewBag.StoneQualities != null) {
                            foreach(var q in (IEnumerable<Yash_Gems___Jewelleries.Models.Masters.StoneQuality>)ViewBag.StoneQualities) {
                                <option value="@q.StoneQualityId">@(q.StoneType + " - " + (q.QualityGrade ?? "Standard"))</option>
                            }
                        }
                    </select>
                </td>
                <td><input name="StoneDetails[${stoneIndex}].Weight" type="number" step="0.001" class="form-control form-control-sm" required></td>
                <td><input name="StoneDetails[${stoneIndex}].Pieces" type="number" class="form-control form-control-sm" required></td>
                <td><input name="StoneDetails[${stoneIndex}].Carat" type="number" step="0.001" class="form-control form-control-sm"></td>
                <td><input name="StoneDetails[${stoneIndex}].Rate" type="number" step="0.01" class="form-control form-control-sm" required></td>
                <td><button type="button" class="remove-row btn btn-soft-danger btn-sm"><i class="bx bx-trash"></i></button></td>
            `;
            tbody.insertBefore(tr, document.getElementById('no-stone-row'));
            stoneIndex++;
            toggleNoDataMessage('stone-body', 'no-stone-row');
        });

        document.addEventListener('click', function(e) {
            if (e.target.closest('.remove-row')) {
                const row = e.target.closest('tr');
                const tbody = row.parentElement;
                const tbodyId = tbody.id;
                row.remove();

                if (tbodyId === 'diamond-body') {
                    toggleNoDataMessage('diamond-body', 'no-diamond-row');
                } else if (tbodyId === 'stone-body') {
                    toggleNoDataMessage('stone-body', 'no-stone-row');
                }
            }
            if (e.target.closest('.existing-remove-row')) {
                const tr = e.target.closest('tr');
                tr.querySelector('.delete-flag').value = "true";
                tr.querySelectorAll('input, select, textarea').forEach(el => el.removeAttribute('required'));
                tr.style.display = 'none';

                const tbody = tr.parentElement;
                const tbodyId = tbody.id;
                if (tbodyId === 'diamond-body') {
                    toggleNoDataMessage('diamond-body', 'no-diamond-row');
                } else if (tbodyId === 'stone-body') {
                    toggleNoDataMessage('stone-body', 'no-stone-row');
                }
            }
        });
    </script>
}