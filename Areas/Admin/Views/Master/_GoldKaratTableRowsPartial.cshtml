@model IEnumerable<Yash_Gems___Jewelleries.Models.Masters.GoldKarat>

@foreach (var item in Model)
{
    <tr>
        <td><a href="javascript: void(0);" class="text-dark fw-medium">#@item.GoldTypeId</a></td>
        <td>
            <div>
                <a href="javascript:void(0);" class="text-dark fw-medium fs-15">@item.GoldCarat</a>
            </div>
        </td>
        <td>
            <div class="progress progress-sm w-75" style="height: 6px;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: @(item.PurityPercentage)%;" aria-valuenow="@item.PurityPercentage" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <span class="text-muted fs-11">@item.PurityPercentage% Purity</span>
        </td>
        <td class="text-muted">
            @(item.Description != null && item.Description.Length > 50 ? item.Description.Substring(0, 47) + "..." : item.Description ?? "N/A")
        </td>
        <td>
            @if (item.IsActive)
            {
                <span class="badge border border-success text-success px-2 py-1 fs-13">Active</span>
            }
            else
            {
                <span class="badge border border-danger text-danger px-2 py-1 fs-13">Inactive</span>
            }
        </td>
        <td>
            @(item.Items?.Count ?? 0) Items
        </td>
        <td>
            <div class="d-flex gap-2">
                <a href="javascript:void(0);" 
                   class="btn btn-light btn-sm" 
                   title="Toggle Status" 
                   onclick="MasterData.toggleStatus(@item.GoldTypeId, 'GoldKarat')">
                    <iconify-icon icon="@(item.IsActive ? "solar:eye-broken" : "solar:eye-closed-broken")" 
                                  class="align-middle fs-18 text-muted"></iconify-icon>
                </a>
                <a href="javascript:void(0);" 
                   class="btn btn-soft-primary btn-sm" 
                   title="Edit"
                   onclick="MasterData.openModal(@item.GoldTypeId)">
                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                </a>
                <a href="javascript:void(0);" 
                   class="btn btn-soft-danger btn-sm" 
                   title="Delete"
                   onclick="MasterData.delete(@item.GoldTypeId)">
                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                </a>
            </div>
        </td>
    </tr>
}
