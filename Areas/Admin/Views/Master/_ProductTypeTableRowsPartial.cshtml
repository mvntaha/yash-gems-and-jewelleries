@model IEnumerable<Yash_Gems___Jewelleries.Models.Masters.ProductType>

@foreach (var item in Model)
{
    <tr>
        <td><a href="javascript: void(0);" class="text-dark fw-medium">#@item.ProductTypeId</a></td>
        <td>
            <div class="d-flex align-items-center gap-2">
                <div class="rounded bg-light avatar-md d-flex align-items-center justify-content-center">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@(item.ImageUrl.StartsWith("/") ? item.ImageUrl : "/" + item.ImageUrl)" alt="@item.ProductTypeName" class="avatar-md">
                    }
                    else
                    {
                        <img src="/uploads/default.png" alt="@item.ProductTypeName" class="avatar-md">
                    }
                </div>
                <div>
                    <a href="javascript:void(0);" class="text-dark fw-medium fs-15">@item.ProductTypeName</a>
                </div>
            </div>
        </td>
        <td class="text-muted">
            @(item.Description != null && item.Description.Length > 60 ? item.Description.Substring(0, 57) + "..." : item.Description ?? "N/A")
        </td>
        <td>
            @if (item.IsActive)
            {
                <span class="badge border border-success text-success px-2 py-1 fs-13">Active</span>
            }
            else
            {
                <span class="badge border border-danger text-danger px-2 py-1 fs-13">Inactive</span>
            }
        </td>
        <td>
            @(item.Items?.Count ?? 0)
        </td>
        <td>
            <div class="d-flex gap-2">
                <a href="javascript:void(0);" 
                   class="btn btn-light btn-sm" 
                   title="Toggle Status" 
                   onclick="MasterData.toggleStatus(@item.ProductTypeId, 'ProductType')">
                    <iconify-icon icon="@(item.IsActive ? "solar:eye-broken" : "solar:eye-closed-broken")" 
                                  class="align-middle fs-18 text-muted"></iconify-icon>
                </a>
                <a href="javascript:void(0);" 
                   class="btn btn-soft-primary btn-sm" 
                   title="Edit"
                   onclick="MasterData.openModal(@item.ProductTypeId)">
                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                </a>
                <a href="javascript:void(0);" 
                   class="btn btn-soft-danger btn-sm" 
                   title="Delete"
                   onclick="MasterData.delete(@item.ProductTypeId)">
                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                </a>
            </div>
        </td>
    </tr>
}

