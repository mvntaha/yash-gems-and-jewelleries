@model Yash_Gems___Jewelleries.ViewModels.DiamondQualityViewModel

<form id="diamondQualityForm" asp-area="Admin" asp-controller="Master" asp-action="Save" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id > 0 ? "Edit" : "Add") Diamond Quality</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" asp-for="Id" value="@Model.Id" />
        <input type="hidden" name="entityType" id="entityType" value="diamondquality" />
        <input type="hidden" name="RowVersion" asp-for="RowVersion" />

        <div class="row">
            <div class="col-lg-6">
                <div class="mb-3">
                    <label asp-for="QualityGrade" class="form-label">Quality Grade</label>
                    <input name="QualityGrade" asp-for="QualityGrade" class="form-control" placeholder="e.g. VVS1, VS2, SI1" value="@Model.QualityGrade">
                    <span asp-validation-for="QualityGrade" class="text-danger fs-12"></span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="mb-3">
                    <label asp-for="Clarity" class="form-label">Clarity</label>
                    <input name="Clarity" asp-for="Clarity" class="form-control" placeholder="e.g. Flawless" value="@Model.Clarity">
                    <span asp-validation-for="Clarity" class="text-danger fs-12"></span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="mb-3">
                    <label asp-for="Color" class="form-label">Color Range</label>
                    <input name="Color" asp-for="Color" class="form-control" placeholder="e.g. D-F (Colorless)" value="@Model.Color">
                    <span asp-validation-for="Color" class="text-danger fs-12"></span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="mb-3">
                    <label asp-for="Cut" class="form-label">Cut Quality</label>
                    <input name="Cut" asp-for="Cut" class="form-control" placeholder="e.g. Excellent / Ideal" value="@Model.Cut">
                    <span asp-validation-for="Cut" class="text-danger fs-12"></span>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea name="Description" asp-for="Description" class="form-control bg-light-subtle" rows="4" placeholder="Type quality description">@Model.Description</textarea>
                    <span asp-validation-for="Description" class="text-danger fs-12"></span>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-check form-switch mb-3">
                    <input asp-for="IsActive" value="true" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsActive" class="form-check-label fw-medium">Active Status</label>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer border-top">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary" id="btnSaveDiamondQuality">
            <span class="spinner-border spinner-border-sm d-none" id="saveSpinner" role="status"></span>
            <span id="saveText">Save Diamond Quality</span>
        </button>
    </div>
</form>

