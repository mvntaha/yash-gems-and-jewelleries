<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Title Meta -->
    <meta charset="utf-8" />
    <title>@ViewData["Title"] | Yash Gems & Jewelleries</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- App favicon -->
    <link rel="shortcut icon" href="/app/images/logo/short-logo.svg">

    <!-- Vendor css -->
    <link href="/admin/css/vendor.min.css" rel="stylesheet" type="text/css" />

    <!-- Icons css -->
    <link href="/admin/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- App css -->
    <link href="/admin/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- Theme Config Javascript -->
    <script src="/admin/js/config.js"></script>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Start Wrapper -->
    <div class="wrapper">

        <!-- ========== Topbar Start ========== -->
        <header class="topbar">
            <div class="container-fluid">
                <div class="navbar-header">
                    <div class="d-flex align-items-center">
                        <!-- Menu Toggle Button -->
                        <div class="topbar-item">
                            <button type="button" class="button-toggle-menu me-2">
                                <iconify-icon icon="solar:hamburger-menu-broken" class="fs-24 align-middle"></iconify-icon>
                            </button>
                        </div>

                        <!-- Menu Toggle Button -->
                        <div class="topbar-item">
                            <h4 class="fw-bold topbar-button pe-none text-uppercase mb-0">@ViewData["Title"]</h4>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-1">

                        <!-- Theme Color (Light/Dark) -->
                        <div class="topbar-item">
                            <button type="button" class="topbar-button" id="light-dark-mode">
                                <iconify-icon icon="solar:moon-bold-duotone" class="fs-24 align-middle"></iconify-icon>
                            </button>
                        </div>

                        <!-- Notification -->
                        <div class="topbar-item">
                            <a href="@Url.Action("Index", "Notifications", new { area = "Admin" })" 
                               class="topbar-button position-relative" 
                               id="page-header-notifications-dropdown">
                                <iconify-icon icon="solar:bell-bing-bold-duotone" class="fs-24 align-middle"></iconify-icon>
                            </a>
                        </div>


                        <!-- Theme Setting -->
                        <div class="topbar-item d-none d-md-flex">
                            <button type="button" class="topbar-button" id="theme-settings-btn" data-bs-toggle="offcanvas" data-bs-target="#theme-settings-offcanvas" aria-controls="theme-settings-offcanvas">
                                <iconify-icon icon="solar:settings-bold-duotone" class="fs-24 align-middle"></iconify-icon>
                            </button>
                        </div>

                        <!-- App Search-->
                        <form class="app-search d-none d-md-block ms-2" method="get" action="@Url.Action("Index", "Item", new { area = "Admin" })">
                            <div class="position-relative">
                                <input type="search" name="searchTerm" class="form-control" placeholder="Search..." autocomplete="off" value="@Context.Request.Query["searchTerm"]">
                                <iconify-icon icon="solar:magnifer-linear" class="search-widget-icon"></iconify-icon>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <!-- Right Sidebar (Theme Settings) -->
        <div>
            <div class="offcanvas offcanvas-end border-0" tabindex="-1" id="theme-settings-offcanvas">
                <div class="d-flex align-items-center bg-primary p-3 offcanvas-header">
                    <h5 class="text-white m-0">Theme Settings</h5>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>

                <div class="offcanvas-body p-0">
                    <div data-simplebar class="h-100">
                        <div class="p-3 settings-bar">

                            <div>
                                <h5 class="mb-3 font-16 fw-semibold">Color Scheme</h5>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-bs-theme" id="layout-color-light" value="light">
                                    <label class="form-check-label" for="layout-color-light">Light</label>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-bs-theme" id="layout-color-dark" value="dark">
                                    <label class="form-check-label" for="layout-color-dark">Dark</label>
                                </div>
                            </div>

                            <div>
                                <h5 class="my-3 font-16 fw-semibold">Topbar Color</h5>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-topbar-color" id="topbar-color-light" value="light">
                                    <label class="form-check-label" for="topbar-color-light">Light</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-topbar-color" id="topbar-color-dark" value="dark">
                                    <label class="form-check-label" for="topbar-color-dark">Dark</label>
                                </div>
                            </div>


                            <div>
                                <h5 class="my-3 font-16 fw-semibold">Menu Color</h5>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-menu-color" id="leftbar-color-light" value="light">
                                    <label class="form-check-label" for="leftbar-color-light">
                                        Light
                                    </label>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-menu-color" id="leftbar-color-dark" value="dark">
                                    <label class="form-check-label" for="leftbar-color-dark">
                                        Dark
                                    </label>
                                </div>
                            </div>

                            <div>
                                <h5 class="my-3 font-16 fw-semibold">Sidebar Size</h5>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-menu-size" id="leftbar-size-default" value="default">
                                    <label class="form-check-label" for="leftbar-size-default">
                                        Default
                                    </label>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-menu-size" id="leftbar-size-small" value="condensed">
                                    <label class="form-check-label" for="leftbar-size-small">
                                        Condensed
                                    </label>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-menu-size" id="leftbar-hidden" value="hidden">
                                    <label class="form-check-label" for="leftbar-hidden">
                                        Hidden
                                    </label>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-menu-size" id="leftbar-size-small-hover-active" value="sm-hover-active">
                                    <label class="form-check-label" for="leftbar-size-small-hover-active">
                                        Small Hover Active
                                    </label>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="data-menu-size" id="leftbar-size-small-hover" value="sm-hover">
                                    <label class="form-check-label" for="leftbar-size-small-hover">
                                        Small Hover
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="offcanvas-footer border-top p-3 text-center">
                    <div class="row">
                        <div class="col">
                            <button type="button" class="btn btn-danger w-100" id="reset-layout">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- ========== Topbar End ========== -->
        <!-- ========== App Menu Start ========== -->
        <div class="main-nav">
            <!-- Sidebar Logo -->
            <div class="logo-box">
                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="logo-dark">
                    <img src="/admin/images/logo-sm.png" class="logo-sm" alt="logo sm">
                    <img src="/admin/images/logo-dark.png" class="logo-lg" alt="logo dark">
                </a>

                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="logo-light">
                    <img src="/admin/images/logo-sm.png" class="logo-sm" alt="logo sm">
                    <img src="/admin/images/logo-light.png" class="logo-lg" alt="logo light">
                </a>
            </div>

            <!-- Menu Toggle Button (sm-hover) -->
            <button type="button" class="button-sm-hover" aria-label="Show Full Sidebar">
                <iconify-icon icon="solar:double-alt-arrow-right-bold-duotone" class="button-sm-hover-icon"></iconify-icon>
            </button>

            <div class="scrollbar" data-simplebar>
                <ul class="navbar-nav" id="navbar-nav">

                    <li class="menu-title">General</li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:widget-5-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Dashboard </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Item", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:hand-stars-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Products </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Order", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:bag-smile-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Orders </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Customer", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:users-group-two-rounded-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Customers </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Inquiries", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:chat-round-dots-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Inquiries </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Banners", "Dashboard", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:gallery-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Banners </span>
                        </a>
                    </li>

                    <li class="menu-title mt-2">Master Data</li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Master", new { area = "Admin", type = "Category" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:clipboard-list-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Categories </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Master", new { area = "Admin", type = "Brand" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:shop-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Brands </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Master", new { area = "Admin", type = "Certificate" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:diploma-verified-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Certificates </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Master", new { area = "Admin", type = "GoldKarat" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:crown-star-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Gold Karats </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Master", new { area = "Admin", type = "ProductType" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:checklist-minimalistic-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Product Types </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Master", new { area = "Admin", type = "DiamondQuality" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:star-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Diamond Qualities </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Master", new { area = "Admin", type = "StoneQuality" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:star-circle-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Stone Qualities </span>
                        </a>
                    </li>

                    <li class="menu-title mt-2">Reports</li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Sales", "Report", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:diagram-up-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Sales </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Inventory", "Report", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:box-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Inventory </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Customer", "Report", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:users-group-two-rounded-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Customers </span>
                        </a>
                    </li>

                    <li class="menu-title mt-2">Others</li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Notifications", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:bell-bing-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Notifications </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Newsletter", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:letter-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Newsletter </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Setting", "Dashboard", new { area = "Admin" })">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:settings-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Settings </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <form id="adminLogoutForm" method="post" action="@Url.Action("Logout", "Account", new { area = "" })" style="display:none;">
                            @Html.AntiForgeryToken()
                        </form>
                        <a class="nav-link" href="javascript:void(0)" onclick="document.getElementById('adminLogoutForm').submit()">
                            <span class="nav-icon">
                                <iconify-icon icon="solar:logout-2-bold-duotone"></iconify-icon>
                            </span>
                            <span class="nav-text"> Logout </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <!-- ========== App Menu End ========== -->
        <!-- ==================================================== -->
        <!-- Start right Content here -->
        <!-- ==================================================== -->
        <div class="page-content">

            <!-- Start Body -->
                @RenderBody()
            <!-- End Body -->

            <!-- Global Toast Renderer -->
            <div id="global-toast-container" class="d-none">
                @if (TempData["Success"] != null)
                {
                    <div data-admin-toast data-message="@TempData["Success"]" data-type="success"></div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div data-admin-toast data-message="@TempData["SuccessMessage"]" data-type="success"></div>
                }
                @if (TempData["Error"] != null)
                {
                    <div data-admin-toast data-message="@TempData["Error"]" data-type="danger"></div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div data-admin-toast data-message="@TempData["ErrorMessage"]" data-type="danger"></div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div data-admin-toast data-message="@TempData["Warning"]" data-type="warning"></div>
                }
                @if (TempData["Info"] != null)
                {
                    <div data-admin-toast data-message="@TempData["Info"]" data-type="info"></div>
                }
            </div>

            <!-- ========== Footer Start ========== -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12 text-center">
                            @DateTime.Now.Year &copy; Yash Gems & Jewelleries.
                        </div>
                    </div>
                </div>
            </footer>
            <!-- ========== Footer End ========== -->
        </div>
        <!-- End Page Content -->
    </div>
    <!-- End Wrapper -->
     <!-- jQuery (only once, before dependent scripts) -->
     <script src="/lib/jquery/dist/jquery.min.js"></script>
     
     <!-- Vendor Javascript -->
     <script src="/admin/js/vendor.js"></script>

     <!-- Bootstrap Bundle -->
     <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
     <script src="/app/js/bootstrap.min.js"></script>

     <!-- App Javascript -->
     <script src="/admin/js/app.js"></script>
     <script src="/admin/js/admin-toast.js"></script>
     @* admin-common.js is being deprecated in favor of admin-toast.js *@
     <script src="/js/admin/admin-common.js"></script>

     <!-- Vector Map Javascript -->
     <script src="/admin/vendor/jsvectormap/js/jsvectormap.min.js"></script>
     <script src="/admin/vendor/jsvectormap/maps/world-merc.js"></script>
     <script src="/admin/vendor/jsvectormap/maps/world.js"></script>

     <!-- Dashboard Javascript -->
     <script src="/admin/js/pages/dashboard.js"></script>

     <!-- Validation Scripts -->
     <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
     <script src="/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

     <!-- SignalR & Notifications -->
     <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
     <script src="/admin/js/notification.js"></script>

     @RenderSection("Scripts", required: false)

</body>
</html>