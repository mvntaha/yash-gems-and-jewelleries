@model Yash_Gems___Jewelleries.ViewModels.AdminOrderIndexViewModel
@using Yash_Gems___Jewelleries.Models.Enums
@{
    ViewData["Title"] = "Orders";
}

<!-- Start Container Fluid -->
<div class="container-xxl">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="d-flex card-header justify-content-between align-items-center">
                    <div>
                        <h4 class="card-title">All Order List</h4>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle btn btn-sm btn-outline-light rounded" data-bs-toggle="dropdown" aria-expanded="false">
                                Filter: @Model.CurrentStatus
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="@Url.Action("Index", "Order", new { status = "All" })" class="dropdown-item">All Orders</a>
                                <a href="@Url.Action("Index", "Order", new { status = "Pending" })" class="dropdown-item">Pending</a>
                                <a href="@Url.Action("Index", "Order", new { status = "Confirmed" })" class="dropdown-item">Confirmed</a>
                                <a href="@Url.Action("Index", "Order", new { status = "Processing" })" class="dropdown-item">Processing</a>
                                <a href="@Url.Action("Index", "Order", new { status = "Shipped" })" class="dropdown-item">Shipped</a>
                                <a href="@Url.Action("Index", "Order", new { status = "Delivered" })" class="dropdown-item">Delivered</a>
                                <a href="@Url.Action("Index", "Order", new { status = "Cancelled" })" class="dropdown-item">Cancelled</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 table-hover table-centered">
                            <thead class="bg-light-subtle">
                                <tr>
                                    <th>Order ID</th>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Payment Method</th>
                                    <th>Items</th>
                                    <th>Order Status</th>
                                    <th>Last Updated</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Orders)
                                {
                                    <tr>
                                        <td>
                                            #@item.OrderNumber
                                        </td>
                                        <td>@item.OrderDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <a href="@Url.Action("Detail", "Customer", new { id = item.UserId })" class="link-primary fw-medium">@item.CustomerName</a>
                                        </td>
                                        <td> @item.TotalAmount.ToString("C")</td>
                                        <td> @item.PaymentMethod</td>
                                        <td> @item.OrderItems.Count</td>
                                        <td>
                                            @{
                                                var statusClass = item.OrderStatus switch
                                                {
                                                    OrderStatus.Pending => "border-secondary text-secondary",
                                                    OrderStatus.Confirmed => "border-primary text-primary",
                                                    OrderStatus.Processing => "border-warning text-warning",
                                                    OrderStatus.Shipped => "border-info text-info",
                                                    OrderStatus.Delivered => "border-success text-success",
                                                    OrderStatus.Cancelled => "border-danger text-danger",
                                                    OrderStatus.Returned => "border-dark text-dark",
                                                    _ => "border-secondary text-secondary"
                                                };
                                            }
                                            <span class="badge border @statusClass px-2 py-1 fs-13">@item.OrderStatus</span>
                                        </td>
                                        <td>
                                            @if (item.ModifiedDate.HasValue)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <span>@item.ModifiedDate.Value.ToString("MMM dd, HH:mm")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No updates</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("Detail", "Order", new { id = item.OrderId })" class="btn btn-light btn-sm" title="View Detail"><iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon></a>
                                                <a href="@Url.Action("Detail", "Order", new { id = item.OrderId })" class="btn btn-soft-primary btn-sm" title="Manage Order"><iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- end table-responsive -->
                </div>
                @if (Model.Pagination.TotalPages > 1)
                {
                    <div class="card-footer border-top">
                        <nav aria-label="Page navigation example">
                            <ul class="pagination justify-content-end mb-0">
                                <li class="page-item @(Model.Pagination.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", "Order", new { status = Model.CurrentStatus, pageIndex = Model.Pagination.CurrentPage - 1 })">Previous</a>
                                </li>

                                @{
                                    int maxPagesToShow = 5;
                                    int startPage = Math.Max(1, Model.Pagination.CurrentPage - (maxPagesToShow / 2));
                                    int endPage = Math.Min(Model.Pagination.TotalPages, startPage + maxPagesToShow - 1);

                                    if (endPage - startPage + 1 < maxPagesToShow)
                                    {
                                        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", "Order", new { status = Model.CurrentStatus, pageIndex = 1 })">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", "Order", new { status = Model.CurrentStatus, pageIndex = i })">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.Pagination.TotalPages)
                                {
                                    @if (endPage < Model.Pagination.TotalPages - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", "Order", new { status = Model.CurrentStatus, pageIndex = Model.Pagination.TotalPages })">@Model.Pagination.TotalPages</a>
                                    </li>
                                }

                                <li class="page-item @(Model.Pagination.CurrentPage >= Model.Pagination.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", "Order", new { status = Model.CurrentStatus, pageIndex = Model.Pagination.CurrentPage + 1 })">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- End Container Fluid -->
