@model Yash_Gems___Jewelleries.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Settings";
}

<div class="container-xxl">
    <form id="settingsForm" asp-action="Setting" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title d-flex align-items-center gap-1"><iconify-icon icon="solar:shop-2-bold-duotone" class="text-primary fs-20"></iconify-icon>Store Settings</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Store Name</label>
                                    <input class="form-control" value="Yash Gems & Jewelleries" readonly>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Store Owner Full Name</label>
                                    <input class="form-control" value="Yash Admin" readonly>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label asp-for="OwnerPhoneNumber" class="form-label"></label>
                                    <input asp-for="OwnerPhoneNumber" class="form-control" placeholder="Number">
                                    <span asp-validation-for="OwnerPhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label asp-for="OwnerEmail" class="form-label"></label>
                                    <input asp-for="OwnerEmail" class="form-control" placeholder="Email">
                                    <span asp-validation-for="OwnerEmail" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="mb-3">
                                    <label asp-for="FullAddress" class="form-label"></label>
                                    <textarea asp-for="FullAddress" class="form-control bg-light-subtle" rows="3" placeholder="Type address"></textarea>
                                    <span asp-validation-for="FullAddress" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="ZipCode" class="form-label"></label>
                                    <input asp-for="ZipCode" class="form-control" placeholder="zip-code">
                                    <span asp-validation-for="ZipCode" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="City" class="form-label"></label>
                                    <input asp-for="City" class="form-control" placeholder="City">
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3">
                                    <label asp-for="Country" class="form-label"></label>
                                    <input asp-for="Country" class="form-control" placeholder="Country">
                                    <span asp-validation-for="Country" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title d-flex align-items-center gap-1"><iconify-icon icon="solar:letter-bold-duotone" class="text-primary fs-20"></iconify-icon>Email Settings</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input class="form-control" value="info@yash.com" readonly>
                        </div>
                        <div class="">
                            <label class="form-label">Password</label>
                            <input class="form-control" value="••••••••" type="password" readonly>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title d-flex align-items-center gap-1"><iconify-icon icon="solar:ticket-sale-bold-duotone" class="text-primary fs-20"></iconify-icon>Tax Settings</h4>
                    </div>
                    <div class="card-body">
                        <p>Prices with Tax</p>
                        <div class="d-flex gap-2 align-items-center mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PricesWithTaxDisplay" value="true" id="taxYes" @(ViewBag.PricesWithTax == true ? "checked" : "")>
                                <label class="form-check-label" for="taxYes">
                                    Yes
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PricesWithTaxDisplay" value="false" id="taxNo" @(ViewBag.PricesWithTax == false ? "checked" : "")>
                                <label class="form-check-label" for="taxNo">
                                    No
                                </label>
                            </div>
                        </div>
                        <div class="mb-1 pb-1">
                            <label asp-for="DefaultTaxRate" class="form-label"></label>
                            <input asp-for="DefaultTaxRate" class="form-control" type="number" step="0.01">
                            <span asp-validation-for="DefaultTaxRate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-end mb-3">
            <a asp-action="Index" class="btn btn-danger">Cancel</a>
            <button type="submit" id="btnSaveSettings" class="btn btn-primary d-inline-flex align-items-center gap-1">
                <span id="saveSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                <span id="saveText">Save Changes</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#settingsForm').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                
                // Validate form before submission
                if (!form.valid()) {
                    console.warn('Settings form validation failed');
                    AdminPanel.showToast('Please fix the validation errors before saving.', 'warning');
                    return false;
                }

                var btn = $('#btnSaveSettings');
                var spinner = $('#saveSpinner');
                var text = $('#saveText');

                // Disable button and show loading state
                btn.prop('disabled', true);
                spinner.removeClass('d-none');
                text.text('Saving...');

                console.log('Submitting settings form...', {
                    action: form.attr('action'),
                    data: form.serialize()
                });

                $.ajax({
                    type: "POST",
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function (res) {
                        console.log('Settings save response:', res);
                        AdminPanel.handleResponse(res);
                    },
                    error: function (xhr, status, error) {
                        console.error('Settings save error:', {
                            status: xhr.status,
                            statusText: xhr.statusText,
                            responseText: xhr.responseText,
                            error: error
                        });
                        
                        var errorMsg = 'An unexpected error occurred while saving settings.';
                        
                        // Try to extract error message from response
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.status === 400) {
                            errorMsg = 'Invalid data submitted. Please check your inputs.';
                        } else if (xhr.status === 500) {
                            errorMsg = 'Server error occurred. Please try again or contact support.';
                        } else if (xhr.status === 0) {
                            errorMsg = 'Network error. Please check your connection.';
                        }
                        
                        AdminPanel.showToast(errorMsg, 'danger');
                    },
                    complete: function () {
                        // Re-enable button and reset state
                        btn.prop('disabled', false);
                        spinner.addClass('d-none');
                        text.text('Save Changes');
                        console.log('Settings form submission complete');
                    }
                });
            });
        });
    </script>
}
