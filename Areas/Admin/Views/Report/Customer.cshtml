@using Yash_Gems___Jewelleries.Areas.Admin.Models.ViewModels.Report
@model CustomerReportViewModel

@{
    ViewData["Title"] = "Customer Report";
}

<div class="container-xxl">
    <div class="row">
        <div class="col-md-6 col-xl-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Total Customers</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.TotalCustomers</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:users-group-two-rounded-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Active Customers</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.ActiveCustomers</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:user-check-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Customer Revenue</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.TotalRevenueFromCustomers.ToString("C")</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:hand-money-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center gap-1">
                    <h4 class="card-title flex-grow-1">Customer Details</h4>
                    <div class="d-flex gap-2">
                        <a asp-action="ExportCustomer" class="btn btn-danger btn-sm">
                            Export Excel
                        </a>
                        <a asp-action="ExportCustomerPdf" class="btn btn-success btn-sm">
                            Export PDF
                        </a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>Customer Info</th>
                                <th>Latest Invoice</th>
                                <th>Status</th>
                                <th>Total Spent</th>
                                <th>Orders</th>
                                <th>Last Order</th>
                                <th>Payment</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded bg-light avatar-md d-flex align-items-center justify-content-center">
                                                    <img src="@(string.IsNullOrEmpty(item.ProfilePictureUrl) ? "/uploads/dummy-user.jpg" : item.ProfilePictureUrl)" alt="@item.FullName" class="avatar-md">
                                                </div>
                                                <div>
                                                    <a href="@Url.Action("Detail", "Customer", new { id = item.UserId })" class="text-dark fw-medium fs-15">@item.FullName</a>
                                                    <p class="text-muted mb-0 mt-1 fs-13">@item.Email</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.LatestInvoiceId))
                                            {
                                                <span class="text-body">#@item.LatestInvoiceId</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No Invoices</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge border border-success text-success px-2 py-1 fs-13">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge border border-danger text-danger px-2 py-1 fs-13">Inactive</span>
                                            }
                                        </td>
                                        <td class="fw-medium">@item.TotalSpent.ToString("C")</td>
                                        <td>@item.TotalOrders</td>
                                        <td>@(item.LastOrderDate?.ToString("dd MMM, yyyy") ?? "N/A")</td>
                                        <td>@(item.PreferredPaymentMethod ?? "N/A")</td>
                                        <td>
                                            <a href="@Url.Action("Detail", "Customer", new { id = item.UserId })" class="btn btn-light btn-sm" title="View Detail">
                                                <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No customer records found matching the filters.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>