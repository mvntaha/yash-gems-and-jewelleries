@using Yash_Gems___Jewelleries.Areas.Admin.Models.ViewModels.Report
@using Yash_Gems___Jewelleries.Models.Enums
@model SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
}

<div class="container-xxl">
    <div class="row">
        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Total Sales</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.TotalSales.ToString("C")</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:hand-money-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Net Sales</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.NetSales.ToString("C")</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:wallet-money-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Total Orders</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.TotalOrders</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:clipboard-list-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Pending Orders</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.PendingOrders</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:clock-circle-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center gap-1">
                    <h4 class="card-title flex-grow-1">Sales Details</h4>
                    <div class="d-flex gap-2">
                        <a asp-action="ExportSales" class="btn btn-danger btn-sm">
                            Export Excel
                        </a>
                        <a asp-action="ExportSalesPdf" class="btn btn-success btn-sm">
                            Export PDF
                        </a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Payment Method</th>
                                <th>Payment Status</th>
                                <th class="text-end">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="text-primary fw-medium">#@item.OrderNumber</td>
                                        <td>@item.OrderDate.ToShortDateString()</td>
                                        <td>@item.CustomerName</td>
                                        <td>
                                            <span class="badge @(item.OrderStatus == "Delivered" ? "border border-success text-success" : item.OrderStatus == "Cancelled" ? "border border-danger text-danger" : "border border-warning text-warning") px-2 py-1 fs-13">
                                                @item.OrderStatus
                                            </span>
                                        </td>
                                        <td>@item.PaymentMethod</td>
                                        <td>
                                            <span class="badge @(item.PaymentStatus == "Completed" ? "border border-success text-success" : item.PaymentStatus == "Cancelled" ? "border border-danger text-danger" : "border border-warning text-warning") px-2 py-1 fs-13">
                                                @item.PaymentStatus
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold">@item.TotalAmount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No sales records found for the selected criteria.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
</div>