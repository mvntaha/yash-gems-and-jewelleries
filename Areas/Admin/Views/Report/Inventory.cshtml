@using Yash_Gems___Jewelleries.Areas.Admin.Models.ViewModels.Report
@model InventoryReportViewModel

@{
    ViewData["Title"] = "Inventory Report";
}

<div class="container-xxl">
    <div class="row">
        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Total Product Items</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.TotalItems</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:box-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Stock Valuation</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.TotalInventoryValue.ToString("C")</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:hand-money-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Low Stock Items</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.LowStockCount</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:bag-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title mb-2 d-flex align-items-center gap-2">Out Of Stock</h4>
                            <p class="text-muted fw-medium fs-22 mb-0">@Model.Summary.OutOfStockCount</p>
                        </div>
                        <div>
                            <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                <iconify-icon icon="solar:bag-cross-broken" class="fs-32 text-primary avatar-title"></iconify-icon>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center gap-1">
                    <h4 class="card-title flex-grow-1">Inventory Details</h4>
                    <div class="d-flex gap-2">
                        <a asp-action="ExportInventory" class="btn btn-danger btn-sm">
                            Export Excel
                        </a>
                        <a asp-action="ExportInventoryPdf" class="btn btn-success btn-sm">
                            Export PDF
                        </a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>Style Code</th>
                                <th>Item Name</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Stock</th>
                                <th>MRP</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="text-primary fw-medium">@item.StyleCode</td>
                                        <td class="fw-semibold">@item.ItemName</td>
                                        <td>@item.CategoryName</td>
                                        <td>@item.BrandName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.MRP.ToString("C")</td>
                                        <td>
                                            <span class="badge @(item.Status == "In Stock" ? "border border-success text-success" : item.Status == "Low Stock" ? "border border-warning text-warning" : "border border-danger text-danger") px-2 py-1 fs-13">
                                                @item.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No inventory records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>