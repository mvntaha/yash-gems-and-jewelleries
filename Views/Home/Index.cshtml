@using Yash_Gems___Jewelleries.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = "Home";

    string formattedTitle = "";

    if (Model.SecondBanner != null)
    {
        var title = Model.SecondBanner.Title;
        var firstSpaceIndex = title.Trim().IndexOf(" ");

        if (firstSpaceIndex > 0)
        {
            // Wrap first word in span, keep the rest, then replace pipe with <br>
            formattedTitle = $"<span class='fst-italic'>{title.Substring(0, firstSpaceIndex)}</span>{title.Substring(firstSpaceIndex)}";
            formattedTitle = formattedTitle.Replace("|", "<br>");
        }
        else
        {
            // If there is only one word, just italicize the whole thing
            formattedTitle = $"<span class='fst-italic'>{title}</span>".Replace("|", "<br>");
        }
    }
}

<!-- Hero Banner -->
<div class="hero-banner ctn-hover">
    <div class="container">
        <div class="hero-main">
            <div class="img_item item-1 hover-repel">
                <img src="/app/images/section/img-item-1.jpg" data-src="/app/images/section/img-item-1.jpg" alt="Treding"
                     class="lazyload wow fadeInLeft">
            </div>
            <div class="img_item item-2 hover-repel d-none d-lg-block">
                <img src="/app/images/section/img-item-2.jpg" data-src="/app/images/section/img-item-2.jpg" alt="Treding"
                     class="lazyload wow fadeInLeftBottom">
            </div>
            <div class="img_item item-3 hover-repel d-none d-lg-block">
                <img src="/app/images/section/img-item-3.jpg" data-src="/app/images/section/img-item-3.jpg" alt="Treding"
                     class="lazyload wow fadeInRightBottom">
            </div>
            <div class="img_item item-4 hover-repel">
                <img src="/app/images/section/img-item-4.jpg" data-src="/app/images/section/img-item-4.jpg" alt="Treding"
                     class="lazyload wow fadeInRight">
            </div>
            <div class="hero-content">
                <h6 class="tag">TRENDING</h6>
                <p class="title text-hero font-2">
                    UNVEIL YOUR <span class="fst-italic">Signature</span> LOOK
                </p>
                <p class="sub">
                    Explore our stunning collection of handcrafted jewelry that blends timeless elegance with modern style.
                    <br class="d-none d-md-block">
                    Each piece is designed to empower your individuality—make your statement today!
                </p>
                <div class="btn-group">
                    <a href="/Item" class="tf-btn text-uppercase type-large">
                        Shop Now
                        <i class="icon-arrow-right-3 fs-24"></i>
                    </a>
                    <a href="/Item" class="link text-uppercase">
                        explore more
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /Hero Banner -->
<!-- Banner Text -->
<section class="flat-spacing-3 pt-0">
    <div class="container">
        <div class="banner_text flex-sm-nowrap">
            <h3 class="text-color-change fw-normal text-sm-start mb-0">
                We believe jewelry is more than an accessory—it’s a story of <br class="d-none d-xl-block">
                individuality and style. Our curated collection blends timeless <br class="d-none d-xl-block">
                craftsmanship with modern design, creating pieces that empower <br class="d-none d-xl-block">
                you to express your unique elegance every day.
            </h3>
            <a href="/Home/AboutUs" class="tf-btn style-4">
                our story
                <i class="icon-arrow-right-2 fs-24"></i>
            </a>
        </div>
    </div>
</section>
<!-- /Banner Text -->
<!-- Slider Product -->
@if (Model.BestProducts != null && Model.BestProducts.Any())
{
    <section class="flat-spacing-3 bg-main-2 overflow-hidden">
        <div class="container-layout-right-4">
            <div class="slide_wrap">
                <div class="title-left">
                    <h2 class="title text-white font-2 fw-normal text-xl-end">
                        <span class="fst-italic">Fresh Finds</span>, Just In
                    </h2>
                </div>
                <div class="wrap">
                    <div class="swiper tf-swiper" 
                         data-preview="3.39" 
                         data-tablet="2.5" 
                         data-mobile-sm="2.2" 
                         data-mobile="1.4" 
                         data-space="10" 
                         data-pagination="1" 
                         data-pagination-sm="1" 
                         data-pagination-md="2" 
                         data-pagination-lg="3">
                        
                        <div class="swiper-wrapper">
                            @foreach (var product in Model.BestProducts)
                            {
                                <div class="swiper-slide">
                                    <div class="card_product--V01 type-space-30">
                                        <div class="card_product-wrapper aspect-ratio-1">
                                            <a asp-action="ProductDetail" asp-controller="Item" asp-route-id="@product.StyleCode" class="product-img">
                                                <img src="@(string.IsNullOrEmpty(product.PrimaryImageUrl) ? "/images/products/placeholder.jpg" : (product.PrimaryImageUrl.StartsWith("/") ? product.PrimaryImageUrl : "/" + product.PrimaryImageUrl))" 
                                                     data-src="@(string.IsNullOrEmpty(product.PrimaryImageUrl) ? "/images/products/placeholder.jpg" : (product.PrimaryImageUrl.StartsWith("/") ? product.PrimaryImageUrl : "/" + product.PrimaryImageUrl))" 
                                                     alt="@product.ItemName" class="img-product lazyload">
                                                
                                                @if (!string.IsNullOrEmpty(product.SecondaryImageUrl))
                                                {
                                                    <img src="@(product.SecondaryImageUrl.StartsWith("/") ? product.SecondaryImageUrl : "/" + product.SecondaryImageUrl)" 
                                                         data-src="@(product.SecondaryImageUrl.StartsWith("/") ? product.SecondaryImageUrl : "/" + product.SecondaryImageUrl)" 
                                                         alt="@product.ItemName" class="img-hover lazyload">
                                                }
                                            </a>

                                            <ul class="list-product-btn">
                                                <li class="wishlist">
                                                    <a href="javascript:void(0);" 
                                                       class="hover-tooltip tooltip-left box-icon btn-add-wishlist @(Model.WishlistStyleCodes.Contains(product.StyleCode) ? "active" : "")"
                                                       data-stylecode="@product.StyleCode">
                                                        <span class="icon @(Model.WishlistStyleCodes.Contains(product.StyleCode) ? "icon-heart" : "icon-heart-2")"></span>
                                                        <span class="tooltip">Wishlist</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="javascript:void(0);" class="hover-tooltip tooltip-left box-icon btn-add-to-cart" data-stylecode="@product.StyleCode">
                                                        <span class="icon icon-shop-cart"></span>
                                                        <span class="tooltip">Add to Cart</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#quickView" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon quickview" data-stylecode="@product.StyleCode">
                                                        <span class="icon icon-view"></span>
                                                        <span class="tooltip">Quick View</span>
                                                    </a>
                                                </li>
                                            </ul>

                                            @if (product.DiscountPercentage > 0)
                                            {
                                                <div class="badge-box">
                                                    <span class="badge-item sale">@product.DiscountPercentage.ToString("0")% OFF</span>
                                                </div>
                                            }
                                            else if (product.IsNew)
                                            {
                                                <div class="badge-box">
                                                    <span class="badge-item new">NEW IN</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="card_product-info">
                                            <a asp-action="Details" asp-controller="Item" asp-route-id="@product.StyleCode" class="name-product h5 text-white fw-normal link text-line-clamp-2">
                                                @product.ItemName
                                            </a>
                                            <div class="price-wrap style-white">
                                                @if (product.DiscountPercentage > 0)
                                                {
                                                    <span class="price-new h5 text-secondary">@product.SellingPrice.ToString("C")</span>
                                                    <span class="price-old fw-normal">@product.MRP.ToString("C")</span>
                                                }
                                                else
                                                {
                                                    <span class="price-new h5 text-white">@product.MRP.ToString("C")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
<!-- /Slider Product -->
<!-- Banner Image Text (New In Banner) -->
@if (Model.FirstBanner != null)
{
    <section>
        <div class="banner_V07">
            <div class="bn-image-text">
                <div class="image">
                    <img src="@(Model.FirstBanner.ImageUrl.StartsWith("/") ? Model.FirstBanner.ImageUrl : "/" + Model.FirstBanner.ImageUrl)" 
                         data-src="@(Model.FirstBanner.ImageUrl.StartsWith("/") ? Model.FirstBanner.ImageUrl : "/" + Model.FirstBanner.ImageUrl)" 
                         alt="@Model.FirstBanner.Title" class="lazyload">
                </div>
                <div class="content wow fadeInUp">
                    <h6 class="caption fw-normal">NEW IN</h6>
                    <p class="title text-hero-2 font-2">
                        @Html.Raw(Model.FirstBanner.Title.Contains(",") 
                            ? Model.FirstBanner.Title.Replace(",", "<br><span class='fst-italic'>") + "</span>" 
                            : Model.FirstBanner.Title)
                    </p>
                    @if (!string.IsNullOrEmpty(Model.FirstBanner.ButtonText))
                    {
                        <a href="@(Model.FirstBanner.LinkUrl ?? "#")" class="tf-btn btn-fill-2 type-large animate-btn text-uppercase">
                            @Model.FirstBanner.ButtonText
                            <i class="icon-arrow-right-2 fs-24"></i>
                        </a>
                    }
                </div>
            </div>
            @if (Model.NewLaunchProduct != null)
            {
                <div class="wrap">
                    <div class="tf-swiper swiper wow fadeInUp" data-cursor="true">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <div class="card_product--V03">
                                    <div class="card_product-wrapper">
                                        <a asp-action="Details" asp-controller="Item" asp-route-id="@Model.NewLaunchProduct.StyleCode">
                                            <img src="@(string.IsNullOrEmpty(Model.NewLaunchProduct.PrimaryImageUrl) ? "/images/products/placeholder.jpg" : (Model.NewLaunchProduct.PrimaryImageUrl.StartsWith("/") ? Model.NewLaunchProduct.PrimaryImageUrl : "/" + Model.NewLaunchProduct.PrimaryImageUrl))" 
                                                 data-src="@(string.IsNullOrEmpty(Model.NewLaunchProduct.PrimaryImageUrl) ? "/images/products/placeholder.jpg" : (Model.NewLaunchProduct.PrimaryImageUrl.StartsWith("/") ? Model.NewLaunchProduct.PrimaryImageUrl : "/" + Model.NewLaunchProduct.PrimaryImageUrl))" 
                                                 alt="@Model.NewLaunchProduct.ItemName" class="lazyload">
                                        </a>
                                    </div>
                                    <div class="card_product-info">
                                        <div class="infor">
                                            <div class="info-product">
                                                <a asp-action="Details" asp-controller="Item" asp-route-id="@Model.NewLaunchProduct.StyleCode" class="name h5 fw-normal link text-line-clamp-2">
                                                    @Model.NewLaunchProduct.ItemName
                                                </a>
                                                <div class="price-wrap">
                                                    @if (Model.NewLaunchProduct.DiscountPercentage > 0)
                                                    {
                                                        <span class="price-new h5 text-secondary">@Model.NewLaunchProduct.SellingPrice.ToString("C")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="price-new h5">@Model.NewLaunchProduct.MRP.ToString("C")</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="btn-action">
                                            <a href="javascript:void(0);" class="tf-btn-icon style-circle hover-tooltip btn-add-wishlist @(Model.WishlistStyleCodes.Contains(Model.NewLaunchProduct.StyleCode) ? "active" : "")" 
                                               data-stylecode="@Model.NewLaunchProduct.StyleCode">
                                                <i class="icon @(Model.WishlistStyleCodes.Contains(Model.NewLaunchProduct.StyleCode) ? "icon-trash" : "icon-heart-2")"></i>
                                                <span class="tooltip">Wishlist</span>
                                            </a>
                                            <a href="javascript:void(0);" class="tf-btn-icon style-circle hover-tooltip btn-add-to-cart" data-stylecode="@Model.NewLaunchProduct.StyleCode" data-quantity="1">
                                                <i class="icon icon-shop-cart"></i>
                                                <span class="tooltip">Add to Cart</span>
                                            </a>
                                            <a href="#quickView" data-bs-toggle="modal" class="tf-btn-icon style-circle hover-tooltip quickview" data-stylecode="@Model.NewLaunchProduct.StyleCode">
                                                <i class="icon icon-view"></i>
                                                <span class="tooltip">Quick View</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="sw-dot-default style-white tf-sw-pagination d-lg-none"></div>
                    </div>
                </div>
            }
        </div>
    </section>
}
<!-- /Banner Image Text -->
<!-- Categories -->
@if (Model.FeaturedCollections.Any())
{   
    <section class="flat-spacing-3">
        <div class="container">
            <h2 class="s-title font-2 text-center text-capitalize wow fadeInUp"><span class="fst-italic">Featured</span> Collections </h2>
            <div class="cls-accordion wow fadeInUp" id="accordionCls">
                @for (int i = 0; i < Model.FeaturedCollections.Count; i++)
                {
                    var collection = Model.FeaturedCollections[i];
                    var isFirst = i == 0;
                    var collapseId = $"collapse-{collection.CategoryId}";
                    
                    <div class="widget-accordion">
                        <div class="accordion-title @(isFirst ? "" : "collapsed")" data-bs-target="#@collapseId" data-bs-toggle="collapse" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@collapseId"
                             role="button">
                            <span class="icon icon-arrow-right-down"></span>
                            <span>@collection.CategoryName</span>
                        </div>
                        <div id="@collapseId" class="collapse @(isFirst ? "show" : "")" data-bs-parent="#accordionCls">
                            <div class="accordion-body">
                                <div class="image">
                                    <img src="@(string.IsNullOrEmpty(collection.ImageUrl) ? "/app/images/collections/placeholder.jpg" : (collection.ImageUrl.StartsWith("/") ? collection.ImageUrl : "/" + collection.ImageUrl))" 
                                         data-src="@(string.IsNullOrEmpty(collection.ImageUrl) ? "/app/images/collections/placeholder.jpg" : (collection.ImageUrl.StartsWith("/") ? collection.ImageUrl : "/" + collection.ImageUrl))" 
                                         alt="@collection.CategoryName" class="lazyload">
                                </div>
                                <div class="cls-info">
                                    <h6 class="count-item">@collection.ItemCount ITEMS</h6>
                                    <p class="text-main-4">
                                        @(collection.Description ?? "No description available for this collection.")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
<!-- /Categories -->
<!-- Discount Banner -->
@if (Model.SecondBanner != null)
{
    <div class="banner_V02">
        <div class="bn-image-blur">
            <div class="blur">
                <img src="@(Model.SecondBanner.ImageUrl.StartsWith("/") ? Model.SecondBanner.ImageUrl : "/" + Model.SecondBanner.ImageUrl)" 
                     data-src="@(Model.SecondBanner.ImageUrl.StartsWith("/") ? Model.SecondBanner.ImageUrl : "/" + Model.SecondBanner.ImageUrl)" 
                     alt="@Model.SecondBanner.Title" class="lazyload">
            </div>
        </div>
        <div class="bn-content bg-linear-light-brown text-white-2">
            @if(!string.IsNullOrEmpty(Model.SecondBanner.DiscountMessage))
            {
                <h6 class="caption text-uppercase wow fadeInUp animated">
                    Discount: @Model.SecondBanner.DiscountMessage
                </h6>
            }
            
            <h2 class="title font-2 fw-normal wow fadeInUp animated">
                @Html.Raw(formattedTitle)
            </h2>

            <p class="sub-title wow fadeInUp animated">
                @Model.SecondBanner.Description
            </p>

            @if (!string.IsNullOrEmpty(Model.SecondBanner.ButtonText))
            {
                <a href="@(Model.SecondBanner.LinkUrl ?? "/Item")" class="tf-btn style-white-2 type-large wow fadeInUp animated">
                    @Model.SecondBanner.ButtonText
                    <i class="icon icon-arrow-right-2"></i>
                </a>
            }
        </div>
    </div>
}
<!-- /Discount Banner -->
