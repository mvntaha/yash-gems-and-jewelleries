@model IEnumerable<Yash_Gems___Jewelleries.Models.Inquiry>
@{
    ViewData["Title"] = "My Inquiries";
}

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a asp-action="Index" asp-controller="Home" class="text-main-4 link-secondary">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>Account</li>
                </ul>
                <h1 class="heading fw-normal text-uppercase">
                    my account
                </h1>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->

<!-- Account -->
<div class="flat-spacing">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="sidebar-account-wrap sidebar-content-wrap sticky-top d-lg-block d-none">
                    <ul class="my-account-nav">
                        <li>
                            <a asp-action="Index" asp-controller="Account" class="link-account">
                                <span class="text">Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Order" asp-controller="Account" class="link-account">
                                <span class="text">My Orders</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Index" asp-controller="Wishlist" class="link-account">
                                <span class="text">My Wishlist</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Inquiries" asp-controller="Account" class="link-account active">
                                <span class="text">Inquiries</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Detail" asp-controller="Account" class="link-account">
                                <span class="text">Detail</span>
                            </a>
                        </li>
                        <li>
                            <form id="logoutFormSidebar" method="post" action="/Account/Logout" style="display:none;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/" />
                            </form>
                            <a href="javascript:void(0)" onclick="document.getElementById('logoutFormSidebar').submit()" class="link-account">
                                <span class="text">Log Out</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            @if (!Model.Any())
            {
            <div class="col-lg-8 d-flex justify-content-center">
                <div class="my-acount-content account-order empty">
                    <div class="ic-img">
                        <img src="/app/images/section/empty-cart.svg" alt="Emty Cart">
                    </div>
                    <p class="title text-lg-2">You have no inquiries yet</p>
                    <p class="sub-title">Got any questions? Contact us now!</p>
                    <a asp-action="ContactUs" asp-controller="Home" class="tf-btn fw-medium btn-out-line">
                        CONTACT US
                    </a>
                </div>
            </div>
            }
            else
            {
            <div class="col-lg-8">
                <div class="my-acount-content account-order">
                    <h4 class="heading fw-normal">My Inquiries</h4>
                    <div class="widget-accordion-2 style-2">
                        @{ int index = 0; }
                        @foreach (var inquiry in Model)
                        {
                            index++;
                            var collapseId = $"inquiry-{inquiry.InquiryId}";

                            <div class="border-bottom">
                                
                                <div class="accordion-title collapsed d-flex justify-content-between align-items-center"
                                    data-bs-target="#@collapseId"
                                    role="button"
                                    data-bs-toggle="collapse"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                    
                                    <span class="fw-medium">
                                        @index. @inquiry.Message
                                    </span>
                                    <span class="icon ic-accordion-custom"></span>
                                </div>

                                <div id="@collapseId" class="collapse" data-bs-parent="#inquiryAccordion">
                                    <div class="accordion-body">
                                        @if (!string.IsNullOrEmpty(inquiry.AdminResponse))
                                        {
                                            <p>@inquiry.AdminResponse</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted fst-italic">No response yet. We will get back to you as soon as possible!</p>
                                        }
                                    </div>
                                </div>
                                
                            </div>
                        }
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</div>
<!-- /Account -->