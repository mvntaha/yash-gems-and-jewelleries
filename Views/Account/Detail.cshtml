@model Yash_Gems___Jewelleries.ViewModels.AccountProfileViewModel

@{
	ViewData["Title"] = "My Account's Details";
}

<style>
    .profile-img-preview {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #f0f0f0;
        margin-bottom: 10px;
    }   
</style>

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a asp-action="Index" asp-controller="Home" class="text-main-4 link-secondary">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>Account</li>
                </ul>
                <h1 class="heading fw-normal text-uppercase">
                    my account
                </h1>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->
<!-- Account -->
<div class="flat-spacing">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="sidebar-account-wrap sidebar-content-wrap sticky-top d-lg-block d-none">
                    <ul class="my-account-nav">
                        <li>
                            <a asp-action="Index" asp-controller="Account" class="link-account">
                                <span class="text">Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Order" asp-controller="Account" class="link-account">
                                <span class="text">My Orders</span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Wishlist")" class="link-account">
                                <span class="text">My Wishlist</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Inquiries" asp-controller="Account" class="link-account">
                                <span class="text">Inquiries</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Detail" asp-controller="Account" class="link-account active">
                                <span class="text">Detail</span>
                            </a>
                        </li>
                        <li>
                            <form id="logoutFormSidebar" method="post" action="/Account/Logout" style="display:none;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/" />
                            </form>
                            <a href="javascript:void(0)" onclick="document.getElementById('logoutFormSidebar').submit()" class="link-account">
                                <span class="text">Log Out</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="my-acount-content account-dashboard">
                    <h4 class="heading fw-normal">ACCOUNT DETAIL</h4>
                    
                    <form asp-action="Detail" method="post" enctype="multipart/form-data" class="form-edit-account style-border">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-5">
                            <div class="col-md-12 text-center">
                                <div class="profile-img-container">
                                    <img id="profilePreview" src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "/uploads/dummy-user.jpg" : (Model.ProfilePictureUrl.StartsWith("/") ? Model.ProfilePictureUrl : "/" + Model.ProfilePictureUrl))" alt="Profile Picture" class="profile-img-preview" />
                                </div>
                                <div class="profile-upload-btn">
                                    <label for="profileUpload" class="tf-btn btn-outline animate-btn fw-medium btn-sm" style="cursor: pointer;">
                                        Change Photo
                                    </label>
                                    <input type="file" asp-for="ProfilePictureFile" id="profileUpload" style="display: none;" accept="image/*" onchange="previewImage(this)" />
                                    <span asp-validation-for="ProfilePictureFile" class="text-danger d-block mt-2"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-content-2">
                            <fieldset class="tf-field-2">
                                <input asp-for="FirstName" class="tf-input" placeholder="" required>
                                <label asp-for="FirstName" class="tf-lable">First name*</label>
                                <span asp-validation-for="FirstName" class="feedback-message error text-sm"></span>
                            </fieldset>
                            <fieldset class="tf-field-2">
                                <input asp-for="LastName" class="tf-input" placeholder="" required>
                                <label asp-for="LastName" class="tf-lable">Last name*</label>
                                <span asp-validation-for="LastName" class="feedback-message error text-sm"></span>
                            </fieldset>
                            <fieldset class="tf-field-2">
                                <input asp-for="Address" class="tf-input" placeholder="">
                                <label asp-for="Address" class="tf-lable">Address</label>
                                <span asp-validation-for="Address" class="feedback-message error text-sm"></span>
                            </fieldset>
                            <fieldset class="tf-field-2">
                                <input asp-for="City" class="tf-input" placeholder="">
                                <label asp-for="City" class="tf-lable">City</label>
                                <span asp-validation-for="City" class="feedback-message error text-sm"></span>
                            </fieldset>
                            <fieldset class="tf-field-2">
                                <input asp-for="State" class="tf-input" placeholder="">
                                <label asp-for="State" class="tf-lable">State</label>
                                <span asp-validation-for="State" class="feedback-message error text-sm"></span>
                            </fieldset>
                            <fieldset class="tf-field-2">
                                <input asp-for="DateOfBirth" class="tf-input" placeholder="">
                                <label asp-for="DateOfBirth" class="tf-lable">Date of Birth</label>
                                <span asp-validation-for="DateOfBirth" class="feedback-message error text-sm"></span>
                            </fieldset>
                        </div>

                        @if (ViewBag.HasPassword == true)
                        {
                            <h5 class="title-pass fw-normal mt-5">Password Change</h5>
                            <div class="form-content-2">
                                <fieldset class="tf-field-2 password-wrapper">
                                    <input asp-for="CurrentPassword" type="password" class="tf-input password-field" placeholder="">
                                    <label asp-for="CurrentPassword" class="tf-lable">Current Password *</label>
                                    <span class="toggle-pass icon-show-password"></span>
                                    <span asp-validation-for="CurrentPassword" class="feedback-message error text-sm"></span>
                                </fieldset>
                                <fieldset class="tf-field-2 password-wrapper">
                                    <input asp-for="NewPassword" type="password" class="tf-input password-field" placeholder="">
                                    <label asp-for="NewPassword" class="tf-lable">New password *</label>
                                    <span class="toggle-pass icon-show-password"></span>
                                    <span asp-validation-for="NewPassword" class="feedback-message error text-sm"></span>
                                </fieldset>
                                <fieldset class="tf-field-2 password-wrapper">
                                    <input asp-for="ConfirmPassword" type="password" class="tf-input password-field" placeholder="">
                                    <label asp-for="ConfirmPassword" class="tf-lable">Confirm password *</label>
                                    <span class="toggle-pass icon-show-password"></span>
                                    <span asp-validation-for="ConfirmPassword" class="feedback-message error text-sm"></span>
                                </fieldset>
                            </div>
                        }

                        @if (TempData["Success"] != null)
                        {
                            <div class="feedback-message success">
                                @TempData["Success"]
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="feedback-message error">
                                @TempData["Error"]
                            </div>
                        }

                        <button type="submit" class="tf-btn btn-fill animate-btn fw-medium">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('profilePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
<!-- /Account -->