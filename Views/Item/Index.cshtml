@model Yash_Gems___Jewelleries.ViewModels.ItemFilterViewModel
@{
    ViewData["Title"] = "Shop";
}

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title type-2">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a asp-controller="Home" asp-action="Index" class="text-main-4 link-secondary">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>
                        <p>Shop</p>
                    </li>
                </ul>
                <h1 class="heading fw-normal text-uppercase">
                    Shop
                    <span class="number-count" id="total-count-display">
                        @Model.TotalItems
                    </span>
                </h1>
            </div>
            <div class="box-text">
                <p class="text-main-4">
                    Discover our jewellery collection to find the latest addition to your jewellery box. From crown, heart and flower rings adorned with clear crystals to simple beaded and wishbone styles, our rings for women collection has it all. Refine your style with a  sterling silver,  14k gold-plated, 14k rose gold-plated or 14k gold ring.
                </p>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->
<!-- Category -->
<div class="flat-spacing-5">
    <div class="container-6">
        <div class="swiper tf-swiper" data-preview="5" data-tablet="4" data-mobile-sm="3" data-mobile="2" data-space-lg="30"
             data-space-md="20" data-space="15" data-pagination="2" data-pagination-sm="3" data-pagination-md="4" data-pagination-lg="5">
            <div class="swiper-wrapper">
                @foreach (var cat in Model.Categories)
                {
                    <div class="swiper-slide">
                        <div class="box_collection--V01 style_2 hover-img">
                            <a asp-action="Index" asp-route-categoryIds="@cat.Id" class="image img-style">
                                <img src="@(string.IsNullOrEmpty(cat.ImageUrl) ? "/uploads/default.png" : (cat.ImageUrl.StartsWith("/") ? cat.ImageUrl : "/" + cat.ImageUrl))" 
                                     alt="@cat.Label" class="lazyload">
                            </a>
                            <a asp-action="Index" asp-route-categoryIds="@cat.Id" class="name-cls link">
                                <span class="h5 fw-normal text-uppercase">
                                    @cat.Label
                                </span>
                            </a>
                        </div>
                    </div>
                }
            </div>
            <div class="sw-dot-default d-flex d-xl-none tf-sw-pagination"></div>
        </div>
    </div>
</div>
<!-- /Category -->
<!-- Product -->
<div class="flat-spacing pt-0">
    <div class="container">
        <div class="tf-shop-control">
            <div class="tf-control-filter">
                <a href="#filterShop" data-bs-toggle="offcanvas" class="tf-btn-filter h4 link">
                    <span class="icon icon-filter"></span>
                    <span class="text">FILTER</span>
                </a>
                <div class="meta-filter-shop">
                    <div id="applied-filters" class="d-flex flex-wrap gap-2">
                        <!-- Dynamic Tags -->
                    </div>
                </div>
            </div>
            <div class="tf-group-layout">
                <div class="tf-dropdown-sort dropdown" id="sort-dropdown">
                    <div class="btn-select" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="text-sort-value">@(Model.SortBy switch { "price_asc" => "Price, low to high", "price_desc" => "Price, high to low", "name_asc" => "Alphabetically, A-Z", "name_desc" => "Alphabetically, Z-A", "newest" => "Newest", _ => "Best selling" })</span>
                        <span class="icon icon-arrow-angle-down"></span>
                    </div>
                    <div class="dropdown-menu">
                        <a href="javascript:void(0)" data-sort="best-selling" class="select-item sort-link @(Model.SortBy == "best-selling" || string.IsNullOrEmpty(Model.SortBy) ? "active" : "")">
                            <span class="text-value-item">Best selling</span>
                        </a>
                        <a href="javascript:void(0)" data-sort="name_asc" class="select-item sort-link @(Model.SortBy == "name_asc" ? "active" : "")">
                            <span class="text-value-item">Alphabetically, A-Z</span>
                        </a>
                        <a href="javascript:void(0)" data-sort="name_desc" class="select-item sort-link @(Model.SortBy == "name_desc" ? "active" : "")">
                            <span class="text-value-item">Alphabetically, Z-A</span>
                        </a>
                        <a href="javascript:void(0)" data-sort="price_asc" class="select-item sort-link @(Model.SortBy == "price_asc" ? "active" : "")">
                            <span class="text-value-item">Price, low to high</span>
                        </a>
                        <a href="javascript:void(0)" data-sort="price_desc" class="select-item sort-link @(Model.SortBy == "price_desc" ? "active" : "")">
                            <span class="text-value-item">Price, high to low</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="wrapper-control-shop gridLayout-wrapper ">
            <div class="wrapper-shop tf-grid-layout tf-col-2 md-col-3 xl-col-4" id="gridLayout">
                <partial name="_ProductListPartial" model="Model" />
            </div>
        </div>
    </div>
</div>
<!-- /Product -->

<!-- Filter Sidebar -->
<div class="offcanvas offcanvas-start canvas-sidebar canvas-filter" id="filterShop" aria-modal="true" role="dialog">
    <div class="canvas-wrapper">
        <div class="canvas-header">
            <span class="title">FILTER</span>
            <span class="icon-close link icon-close-popup" data-bs-dismiss="offcanvas"></span>
        </div>
        <div class="canvas-body">
            <form id="filterForm">
                <input type="hidden" name="sortBy" id="sortByInput" value="@Model.SortBy">
                <input type="hidden" name="searchQuery" value="@Model.SearchQuery">
                <input type="hidden" name="page" id="pageInput" value="@Model.CurrentPage">

                <div class="apply-filter-wrap">
                    <p class="title h6 fw-normal text-uppercase">Applied Filters</p>
                    <div id="applied-filters-sidebar" class="meta-filter-shop mt-2 d-flex flex-wrap gap-2">
                        <div class="count-text text-main-4">No Filter Selected</div>
                    </div>
                </div>

                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#availability" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="availability">
                        <span class="h6 fw-normal text-uppercase">availability</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="availability" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            <li class="list-item">
                                <input type="radio" name="availability" value="" class="tf-check style-2" id="allStock" @(string.IsNullOrEmpty(Model.Availability) ? "checked" : "")>
                                <label for="allStock" class="label">
                                    <span>All</span><span class="count-wrap">[ <span class="count">@Model.TotalCount</span> ]</span>
                                </label>
                            </li>
                            <li class="list-item">
                                <input type="radio" name="availability" value="inStock" class="tf-check style-2" id="inStock" @(Model.Availability == "inStock" ? "checked" : "")>
                                <label for="inStock" class="label">
                                    <span>In Stock</span><span class="count-wrap">[ <span class="count">@Model.InStockCount</span> ]</span>
                                </label>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#product-types" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="product-types">
                        <span class="h6 fw-normal text-uppercase">Product Type</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="product-types" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            @foreach (var pt in Model.ProductTypes)
                            {
                                <li class="list-item">
                                    <input type="checkbox" name="productTypeIds" value="@pt.Id" class="tf-check style-2" id="pt-@pt.Id" @(Model.SelectedProductTypeIds.Contains(pt.Id) ? "checked" : "")>
                                    <label for="pt-@pt.Id" class="label">
                                        <span>@pt.Name</span><span class="count-wrap">[ <span class="count">@pt.ProductCount</span> ]</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#diamond-clarity" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="diamond-clarity">
                        <span class="h6 fw-normal text-uppercase">Diamond Clarity</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="diamond-clarity" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            @foreach (var clarity in Model.AvailableDiamondClarities)
                            {
                                <li class="list-item">
                                    <input type="checkbox" name="diamondClarities" value="@clarity" class="tf-check style-2" id="clarity-@clarity" @(Model.SelectedDiamondClarities.Contains(clarity) ? "checked" : "")>
                                    <label for="clarity-@clarity" class="label">
                                        <span>@clarity</span><span class="count-wrap">[ <span class="count">0</span> ]</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#diamond-color" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="diamond-color">
                        <span class="h6 fw-normal text-uppercase">Diamond Color</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="diamond-color" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            @foreach (var dColor in Model.AvailableDiamondColors)
                            {
                                <li class="list-item">
                                    <input type="checkbox" name="diamondColors" value="@dColor" class="tf-check style-2" id="dcolor-@dColor" @(Model.SelectedDiamondColors.Contains(dColor) ? "checked" : "")>
                                    <label for="dcolor-@dColor" class="label">
                                        <span>@dColor</span><span class="count-wrap">[ <span class="count">0</span> ]</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#carat-weight" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="carat-weight">
                        <span class="h6 fw-normal text-uppercase">Carat Weight</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="carat-weight" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            <li class="list-item">
                                <input type="radio" name="caratRange" value="" class="tf-check style-2" id="all-carat" @(string.IsNullOrEmpty(Model.CaratRange) ? "checked" : "")>
                                <label for="all-carat" class="label"><span>All Weights</span></label>
                            </li>
                            <li class="list-item">
                                <input type="radio" name="caratRange" value="0-0.29" class="tf-check style-2" id="carat-0-29" @(Model.CaratRange == "0-0.29" ? "checked" : "")>
                                <label for="carat-0-29" class="label"><span>Under 0.30</span></label>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#price" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="price">
                        <span class="h6 fw-normal text-uppercase">price</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="price" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            <li class="list-item">
                                <input type="radio" name="priceRange" value="" class="tf-check style-2 price-radio" id="all-price" @(string.IsNullOrEmpty(Model.PriceRange) ? "checked" : "")>
                                <label for="all-price" class="label"><span>All Prices</span></label>
                            </li>
                            <li class="list-item">
                                <input type="radio" name="priceRange" value="0-500" class="tf-check style-2 price-radio" id="u-500" @(Model.PriceRange == "0-500" ? "checked" : "")>
                                <label for="u-500" class="label"><span>Under $500</span></label>
                            </li>
                        </ul>
                        <input type="hidden" name="minPrice" id="minPriceInput" value="@Model.MinPrice">
                        <input type="hidden" name="maxPrice" id="maxPriceInput" value="@Model.MaxPrice">
                    </div>
                </div>

            </form>
        </div>
        <div class="canvas-bottom">
            <button type="button" class="tf-btn btn-reset btn-clear-all-filters">
                <span class="fw-medium">CLEAR ALL</span>
            </button>
            <button type="submit" form="filterForm" class="tf-btn btn-fill animate-btn" data-bs-dismiss="offcanvas">
                <span class="fw-medium">APPLY</span>
            </button>
        </div>
    </div>
</div>
<!-- /Filter Sidebar -->

<!-- Icon Box -->
<div class="flat-spacing-8 bg-main">
    <div class="container">
        <div class="tf-swiper swiper sw-iconbox" data-preview="4" data-tablet="3" data-mobile-sm="2" data-mobile="1" data-space-lg="80"
             data-space-md="30" data-space="15" data-pagination="1" data-pagination-sm="2" data-pagination-md="3" data-pagination-lg="4">
            <div class="swiper-wrapper">
                <!-- item 1 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white">
                        <span class="icon">
                            <i class="icon-box text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">Free Shipping</h4>
                            <p class="text">Enjoy free shipping on all orders</p>
                        </div>
                    </div>
                </div>
                <!-- item 2 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white" data-wow-delay="0.1s">
                        <span class="icon">
                            <i class="icon-credit-card text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">Flexible Payment</h4>
                            <p class="text">Pay with Multiple Credit Cards</p>
                        </div>
                    </div>
                </div>
                <!-- item 3 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white" data-wow-delay="0.2s">
                        <span class="icon">
                            <i class="icon-return text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">14 - Days Return</h4>
                            <p class="text">Free return/exchange within 30 days</p>
                        </div>
                    </div>
                </div>
                <!-- item 4 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white" data-wow-delay="0.3s">
                        <span class="icon">
                            <i class="icon-headphone text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">Premium Support</h4>
                            <p class="text">Enjoy our premium support</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sw-dot-default style-white tf-sw-pagination"></div>
        </div>
    </div>
</div>
<!-- /Icon Box -->

@section Scripts {
    <script src="/app/js/shop-filter.js"></script>
}

