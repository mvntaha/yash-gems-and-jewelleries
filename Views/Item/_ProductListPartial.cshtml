@model Yash_Gems___Jewelleries.ViewModels.ItemFilterViewModel

@foreach (var item in Model.Items)
{
    bool isInWishlist = Model.WishlistStyleCodes.Contains(item.StyleCode);
    <div class="loadItem card_product--V01 grid @(item.Quantity <= 0 ? "out-of-stock" : "")" 
         data-availability="@(item.Quantity > 0 ? "In stock" : "Out of stock")" 
         data-category="@item.CategoryId" 
         data-brand="@item.BrandId">
        <div class="card_product-wrapper">
            <a asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="product-img">
                <img src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/uploads/default.png" : (item.PrimaryImageUrl.StartsWith("/") ? item.PrimaryImageUrl : "/" + item.PrimaryImageUrl))" 
                     data-src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/uploads/default.png" : (item.PrimaryImageUrl.StartsWith("/") ? item.PrimaryImageUrl : "/" + item.PrimaryImageUrl))" 
                     alt="@item.ItemName" class="lazyload img-product">
                @if (!string.IsNullOrEmpty(item.SecondaryImageUrl))
                {
                    <img src="@(item.SecondaryImageUrl.StartsWith("/") ? item.SecondaryImageUrl : "/" + item.SecondaryImageUrl)" 
                         data-src="@(item.SecondaryImageUrl.StartsWith("/") ? item.SecondaryImageUrl : "/" + item.SecondaryImageUrl)" 
                         alt="@item.ItemName" class="lazyload img-hover">
                }
            </a>
            <ul class="list-product-btn">
                <li class="wishlist">
                    <a href="javascript:void(0);" class="hover-tooltip tooltip-left box-icon btn-add-wishlist @(isInWishlist ? "active" : "")" data-stylecode="@item.StyleCode" title="@(isInWishlist ? "Remove from Wishlist" : "Add to Wishlist")">
                        <span class="icon @(isInWishlist ? "icon-trash" : "icon-heart-2")"></span>
                        <span class="tooltip">@(isInWishlist ? "Remove from Wishlist" : "Add to Wishlist")</span>
                    </a>
                </li>
                @if (item.Quantity > 0)
                {
                    <li>
                        <a href="javascript:void(0);" 
                           class="hover-tooltip tooltip-left box-icon btn-add-to-cart" 
                           data-stylecode="@item.StyleCode" 
                           data-quantity="1">
                            <span class="icon icon-shop-cart"></span>
                            <span class="tooltip">Add to Cart</span>
                        </a>
                    </li>
                }
                <li>
                    <a href="#quickView" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon quickview" data-stylecode="@item.StyleCode">
                        <span class="icon icon-view"></span>
                        <span class="tooltip">Quick View</span>
                    </a>
                </li>
            </ul>
            @if (item.IsNewLaunch)
            {
                <div class="badge-box">
                    <span class="badge-item new">NEW IN</span>
                </div>
            }
            else if (item.IsOnSale || item.DiscountPercentage > 0)
            {
                <div class="badge-box">
                    <span class="badge-item sale">@(item.DiscountPercentage > 0 ? $"{(int)item.DiscountPercentage}% OFF" : "SALE")</span>
                </div>
            }

            @if (item.Quantity <= 0)
            {
                <a href="#unavailable" data-bs-toggle="modal" class="variant-box stock bg-main link text-white">
                    <p class="text-center d-none d-md-block">Currently Not Available</p>
                    <p class="text-center d-md-none">Coming Soon</p>
                </a>
            }
        </div>
        <div class="card_product-info">
            <a asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="name-product h5 fw-normal link text-line-clamp-2">
                @item.ItemName
            </a>
            <div class="price-wrap">
                <span class="price-new h5">@item.SellingPrice.ToString("C")</span>
                @if (item.MRP > item.SellingPrice)
                {
                    <span class="price-old fw-normal">@item.MRP.ToString("C")</span>
                }
            </div>
        </div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="wd-full tempo">
        <div class="wg-pagination">
            @if (Model.Page > 1)
            {
                <a href="javascript:void(0)" class="tf-btn-line style-line-2 pagination-link" data-page="@(Model.Page - 1)">
                    <span class="text-body">PREV</span>
                </a>
            }
            else
            {
                <a class="tf-btn-line style-line-2 disabled" style="opacity: 0.5; cursor: not-allowed;">
                    <span class="text-body">PREV</span>
                </a>
            }
            <ul class="pagition-list">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li>
                        @if (i == Model.Page)
                        {
                            <p class="pagination-item active">@i</p>
                        }
                        else
                        {
                            <a href="javascript:void(0)" class="pagination-item link pagination-link" data-page="@i">@i</a>
                        }
                    </li>
                }
            </ul>
            @if (Model.Page < Model.TotalPages)
            {
                <a href="javascript:void(0)" class="tf-btn-line style-line-2 pagination-link" data-page="@(Model.Page + 1)">
                    <span class="text-body">NEXT</span>
                </a>
            }
            else
            {
                <a class="tf-btn-line style-line-2 disabled" style="opacity: 0.5; cursor: not-allowed;">
                    <span class="text-body">NEXT</span>
                </a>
            }

        </div>
    </div>
}
else if (Model.TotalItems > 0)
{
    <div class="wd-full tempo">
        <div class="wg-show-more">
            <p>Showing all @Model.TotalItems products</p>
        </div>
    </div>
}
else
{
    <div class="wd-full tempo text-center">
        <div class="col-12">
            <div class="d-flex justify-content-center">
                <div class="my-acount-content account-order empty">
                    <div class="ic-img">
                        <img src="/app/images/section/empty-cart.svg" alt="Empty Cart">
                    </div>
                    <p class="title text-lg-2">No products found</p>
                    <p class="sub-title">Try adjusting your filters to see more products!</p>
                    <a asp-controller="Item" asp-action="Index" class="tf-btn fw-medium btn-clear-all-filters">
                        CLEAR FILTERS
                    </a>
                </div>
            </div>
        </div>
    </div>
}


