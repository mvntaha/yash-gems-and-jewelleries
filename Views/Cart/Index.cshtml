@model Yash_Gems___Jewelleries.ViewModels.CartViewModel
@{
    ViewData["Title"] = "My Cart";
}

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a asp-controller="Home" asp-action="Index" class="text-main-4 link">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>Cart</li>
                </ul>
                <h1 class="heading fw-normal">
                    shopping cart
                </h1>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->

<!-- Shop Cart -->
<section class="flat-spacing s-shop-cart each-list-prd">
    <div class="container" id="cart-main-container">
        <div class="row">
        @if (Model.Items.Any())
        {
            <div class="col-xl-8">
                <div class="left mb-xl-0">
                    <div class="table-shop-cart table-order-detail">
                        <table>
                            <thead>
                                <tr>
                                    <th class="order_product h6 fw-normal">Product</th>
                                    <th class="order_price h6 fw-normal">price</th>
                                    <th class="order_quantity h6 fw-normal">quantity</th>
                                    <th class="order_subtotal h6 fw-normal">subtotal</th>
                                </tr>
                            </thead>
                            <tbody id="cart-items-container">
                                <partial name="~/Views/Cart/_CartItemsPartial.cshtml" model="Model" />
                            </tbody>
                        </table>
                    </div>
                    
                    <form class="style-border">
                        <fieldset>
                            <label class="label-text">Special instructions for seller</label>
                            <textarea style="height: 206px;"></textarea>
                        </fieldset>
                    </form>
                </div>
            </div>
            <div class="col-xl-4" id="cart-summary-container">
                <partial name="~/Views/Cart/_CartSummaryPartial.cshtml" model="Model" />
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="d-flex justify-content-center">
                    <div class="my-acount-content account-order empty">
                        <div class="ic-img">
                            <img src="/app/images/section/empty-cart.svg" alt="Empty Cart">
                        </div>
                        <p class="title text-lg-2">Your cart is empty</p>
                        <p class="sub-title">It's time to fill it with your favorites!</p>
                        <a asp-action="Index" asp-controller="Item" class="tf-btn fw-medium btn-out-line">
                            SHOPPING
                        </a>
                    </div>
                </div>
            </div>
        }
        </div>
    </div>
</section>
<!-- /Shop Cart -->
<!-- For You -->
<section class="flat-spacing pt-0">
    <div class="container">
        <div class="sect-top wow fadeInUp">
            <h3 class="s-title">YOU MAY ALSO LIKE</h3>
            <div class="group-btn-slider">
                <div class="nav-prev-swiper tf-sw-nav">
                    <i class="icon-arrow-left"></i>
                </div>
                <div class="nav-next-swiper tf-sw-nav">
                    <i class="icon-arrow-right"></i>
                </div>
            </div>
        </div>
        <div dir="ltr" class="swiper tf-swiper wow fadeInUp" data-preview="4" data-tablet="3" data-mobile-sm="2" data-mobile="2"
             data-space-lg="30" data-space-md="20" data-space="15" data-pagination="2" data-pagination-sm="2" data-pagination-md="3"
             data-pagination-lg="4">
            <div class="swiper-wrapper">
                @if (Model.RecommendedProducts != null && Model.RecommendedProducts.Any())
                {
                    foreach (var item in Model.RecommendedProducts)
                    {
                        bool isInWishlist = Model.WishlistStyleCodes.Contains(item.StyleCode);
                        <div class="swiper-slide">
                            <div class="card_product--V01">
                                <div class="card_product-wrapper">
                                    <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="product-img">
                                        @{
                                            var primary = item.PrimaryImageUrl;
                                            var primaryUrl = string.IsNullOrEmpty(primary) ? "/app/images/products/product-1.jpg" : (primary.StartsWith("/") ? primary : "/" + primary);
                                            var secondary = item.SecondaryImageUrl;
                                            var secondaryUrl = string.IsNullOrEmpty(secondary) ? primaryUrl : (secondary.StartsWith("/") ? secondary : "/" + secondary);
                                        }
                                        <img src="@primaryUrl" data-src="@primaryUrl" alt="@item.ItemName" class="lazyload img-product">
                                        <img src="@secondaryUrl" data-src="@secondaryUrl" alt="@item.ItemName" class="lazyload img-hover">
                                    </a>
                                    <ul class="list-product-btn">
                                        <li class="wishlist">
                                            <a href="javascript:void(0);" class="hover-tooltip tooltip-left box-icon btn-add-wishlist @(isInWishlist ? "active" : "")" data-stylecode="@item.StyleCode" title="@(isInWishlist ? "Remove from Wishlist" : "Add to Wishlist")">
                                                <span class="icon @(isInWishlist ? "icon-trash" : "icon-heart-2")"></span>
                                                <span class="tooltip">@(isInWishlist ? "Remove from Wishlist" : "Add to Wishlist")</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="javascript:void(0);" 
                                               class="hover-tooltip tooltip-left box-icon btn-add-to-cart" 
                                               data-stylecode="@item.StyleCode" 
                                               data-quantity="1">
                                                <span class="icon icon-shop-cart"></span>
                                                <span class="tooltip">Add to Cart</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#quickView" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon quickview" data-stylecode="@item.StyleCode">
                                                <span class="icon icon-view"></span>
                                                <span class="tooltip">Quick View</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="card_product-info">
                                    <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="name-product h5 fw-normal link text-line-clamp-2">
                                        @item.ItemName
                                    </a>
                                    <div class="price-wrap">
                                        <span class="price-new h5">@item.SellingPrice.ToString("C")</span>
                                        @if (item.MRP > item.SellingPrice)
                                        {
                                            <span class="price-old fw-normal">@item.MRP.ToString("C")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="sw-dot-default tf-sw-pagination d-xl-none"></div>
        </div>
    </div>
</section>
<!-- /For You -->