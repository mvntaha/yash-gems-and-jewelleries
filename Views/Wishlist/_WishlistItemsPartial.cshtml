@model IEnumerable<Yash_Gems___Jewelleries.Models.Wishlist>

    @if (!Model.Any())
    {
    <div class="wd-full tempo text-center">
        <div class="col-12">
            <div class="d-flex justify-content-center">
                <div class="my-acount-content account-order empty">
                    <div class="ic-img">
                        <img src="/app/images/section/empty-cart.svg" alt="Empty Cart">
                    </div>
                    <p class="title text-lg-2">Your wishlist is empty</p>
                    <p class="sub-title">Browse our collection and find something you love!</p>
                    <a asp-action="Index" asp-controller="Item" class="tf-btn fw-medium btn-out-line">
                        SHOPPING
                    </a>
                </div>
            </div>
        </div>
    </div>
    }
    else
    {
    @Html.AntiForgeryToken()
    @foreach (var wishItem in Model)
    {
    <div class="card_product--V01">
        <div class="card_product-wrapper">
            <span class="remove icon-close" data-wishlistid="@wishItem.WishlistId" title="Remove from wishlist"></span>
            <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@wishItem.StyleCode" class="product-img">
                @{
                    var primaryImg = wishItem.Item.PrimaryImageUrl;
                    var primaryImgUrl = string.IsNullOrEmpty(primaryImg) ? "/uploads/default.png" : (primaryImg.StartsWith("/") ? primaryImg : "/" + primaryImg);
                    var secondaryImg = wishItem.Item.SecondaryImageUrl;
                    var secondaryImgUrl = string.IsNullOrEmpty(secondaryImg) ? primaryImgUrl : (secondaryImg.StartsWith("/") ? secondaryImg : "/" + secondaryImg);
                }
                <img src="@primaryImgUrl" data-src="@primaryImgUrl" alt="@wishItem.Item.ItemName" class="lazyload img-product">
                <img src="@secondaryImgUrl" data-src="@secondaryImgUrl" alt="@wishItem.Item.ItemName" class="lazyload img-hover">
            </a>
            <ul class="list-product-btn d-none d-md-flex">
            @if(wishItem.Item.Quantity > 0)
            {
                <li>
                    <a href="#quickAdd" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon btn-add-to-cart" data-stylecode="@wishItem.StyleCode">
                        <span class="icon icon-shop-cart"></span>
                        <span class="tooltip">Quick Add</span>
                    </a>
                </li>
            }
                <li>
                    <a href="#quickView" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon quickview" data-stylecode="@wishItem.StyleCode">
                        <span class="icon icon-view"></span>
                        <span class="tooltip">Quick View</span>
                    </a>
                </li>
            </ul>
            @if (wishItem.Item.IsNewLaunch)
            {
            <div class="badge-box">
                <span class="badge-item new">NEW IN</span>
            </div>
            }
            else if (wishItem.Item.DiscountPercentage > 0)
            {
            <div class="badge-box">
                <span class="badge-item sale">@wishItem.Item.DiscountPercentage.ToString("0")% OFF</span>
            </div>
            }
            else if (wishItem.Item.Quantity <= 0) { <div class="badge-box">
                <span class="badge-item sold-out">SOLD OUT</span>
        </div>
        }
    </div>
    <div class="card_product-info">
        <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@wishItem.StyleCode" class="name-product h5 fw-normal link text-line-clamp-2">
            @wishItem.Item.ItemName
        </a>
        <div class="price-wrap">
            <span class="price-new h5">@wishItem.Item.SellingPrice.ToString("C")</span>
            @if (wishItem.Item.MRP > wishItem.Item.SellingPrice)
            {
            <span class="price-old fw-normal">@wishItem.Item.MRP.ToString("C")</span>
            }
        </div>
    </div>
    </div>
    }
    }