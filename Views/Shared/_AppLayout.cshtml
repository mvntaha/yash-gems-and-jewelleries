                                    </p>
                                    <div class="tf-collapse-content">
                                        <ul class="footer-menu-list">
                                            <li><a asp-controller="Home" asp-action="Index" class="text-main-4 link">Home</a></li>
                                            <li><a asp-controller="Item" asp-action="Index" class="text-main-4 link">Shop</a></li>
                                            <li><a asp-controller="Wishlist" asp-action="Index" class="text-main-4 link">My Wishlist</a></li>
                                            <li><a asp-controller="Cart" asp-action="Index" class="text-main-4 link">Cart</a></li>
                                            <li><a asp-controller="Account" asp-action="Order" class="text-main-4 link">Orders</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="footer-col-block">
                                    <p class="footer-heading footer-heading-mobile font-2">
                                        ABOUT US
                                    </p>
                                    <div class="tf-collapse-content">
                                        <ul class="footer-menu-list">
                                            <li><a asp-controller="Home" asp-action="AboutUs" class="text-main-4 link">Our Story</a></li>
                                            <li><a asp-controller="Home" asp-action="Learn" class="text-main-4 link">Learn</a></li>
                                            <li><a asp-controller="Account" asp-action="Inquiries" class="text-main-4 link">Inquiries</a></li>
                                            <li><a asp-controller="Home" asp-action="ContactUs" class="text-main-4 link">Contact Us</a></li>
                                            <li><a asp-controller="Account" asp-action="Index" class="text-main-4 link">Account</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="container">
                    <div class="footer-bottom-wrap">
                        <div class="footer-bar-language">
