@using Microsoft.AspNetCore.Identity
@inject ICartService CartService
@inject Yash_Gems___Jewelleries.Services.ILayoutService LayoutService
@inject UserManager<ApplicationUser> UserManager
@{
    var navCategories = await LayoutService.GetCategoriesAsync(7);
    var navFeaturedProducts = await LayoutService.GetFeaturedProductsAsync(7);
    var navNewArrivals = await LayoutService.GetNewArrivalsAsync(7);
    var navBrands = await LayoutService.GetBrandsAsync(7);
    var userId = UserManager.GetUserId(User);
    var guestId = Context.Request.Cookies["GuestCartId"];
    var cartCount = await CartService.GetCartCountAsync(userId, guestId);
    var wishCount = await LayoutService.GetWishlistCountAsync(userId ?? string.Empty);

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - Yash Gems & Jewelleries</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <!-- SEO Meta Tags -->
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Explore exquisite handcrafted jewelry at Yash Gems & Jewelleries. Timeless elegance and modern designs.")">
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "jewelry, gems, rings, necklaces, diamond, gold, handcrafted")">
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")">
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)">
    <meta property="og:title" content="@(ViewData["Title"] ?? "Yash Gems & Jewelleries")">
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Explore exquisite handcrafted jewelry at Yash Gems & Jewelleries.")">
    <meta property="og:image" content="@(ViewData["OgImage"] ?? Context.Request.Scheme + "://" + Context.Request.Host + "/app/images/logo/logo.png")">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="@(ViewData["CanonicalUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)">
    <meta property="twitter:title" content="@(ViewData["Title"] ?? "Yash Gems & Jewelleries")">
    <meta property="twitter:description" content="@(ViewData["MetaDescription"] ?? "Explore exquisite handcrafted jewelry at Yash Gems & Jewelleries.")">
    <meta property="twitter:image" content="@(ViewData["OgImage"] ?? Context.Request.Scheme + "://" + Context.Request.Host + "/app/images/logo/logo.png")">

    <!-- font -->
    <link rel="stylesheet" href="/app/fonts//fonts.css">
    <link rel="stylesheet" href="/app/icon/icomoon/style.css">

    <!-- css -->
    <link rel="stylesheet" href="/app/css/bootstrap.min.css">
    <link rel="stylesheet" href="/app/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="/app/css/animate.css">
    <link rel="stylesheet" type="text/css" href="/app/css/styles.css">

    <!-- Favicon and Touch Icons  -->
    <link rel="shortcut icon" href="/app/images/logo/short-logo.svg">
    <link rel="apple-touch-icon-precomposed" href="/app/images/logo/short-logo.svg">

</head>

<body>
    <!-- Scroll Top -->
    <button id="goTop">
        <span class="border-progress"></span>
        <span class="icon icon-arrow-right-2"></span>
    </button>

    <!-- preload -->
    <div class="preload preload-container" id="preload">
        <div class="preload-logo">
            <div class="spinner"></div>
        </div>
    </div>
    <!-- /preload -->

    <div id="wrapper">
        <!-- Top Bar-->
        <div class="tf-topbar bg-olive-brown">
            <div class="container">
                <div class="topbar-inner">
                    <div dir="ltr" class="swiper tf-swiper" data-loop="true" data-auto="true" data-delay="3000" data-speed="1000" data-space="10"
                         data-direction="vertical">
                        <div class="swiper-wrapper">
                            <!-- item 1 -->
                            <div class="swiper-slide">
                                <div class="has-btn">
                                    <p class="text-caption-3 fw-medium text-white">
                                        FREE STANDARD DELIVERY FOR ALL ORDERS OVER
                                        $200
                                    </p>
                                    <span class="br-line"></span>
                                    <a asp-controller="Item" asp-action="Index" class="tf-btn-line style-white-2 text-uppercase lh-19">
                                        Shop Now
                                        <i class="icon-arrow-top-right-2 fs-10"></i>
                                    </a>
                                </div>
                            </div>
                            <!-- item 2 -->
                            <div class="swiper-slide">
                                <div class="has-btn">
                                    <p class="text-caption-3 fw-medium text-white">
                                        COMPLIMENTARY SHIPPING ON ORDERS ABOVE
                                        $200
                                    </p>
                                    <span class="br-line"></span>
                                    <a asp-controller="Item" asp-action="Index" class="tf-btn-line style-white-2 text-uppercase lh-19">
                                        Shop Now
                                        <i class="icon-arrow-top-right-2 fs-10"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <!-- /Top Bar -->
        <!-- Header -->
        <header class="tf-header line-bt-2">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-4 col-3 d-xl-none">
                        <a href="#mobileMenu" data-bs-toggle="offcanvas" class="btn-mobile-menu">
                            <span></span>
                        </a>
                    </div>
                    <div class="col-xl-2 col-md-4 col-6">
                        <a asp-controller="Home" asp-action="Index" class="logo-site">
                            <img src="/app/images/logo/logo.svg" alt="Yash Logo">
                        </a>
                    </div>
                    <div class="col-xl-8 d-none d-xl-block">
                        <nav class="box-navigation">
                            <ul class="box-nav-menu">
                                <li class="menu-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                                    <a asp-controller="Home" asp-action="Index" class="item-link">Home</a>
                                </li>
                                <li class="menu-item @(currentController == "Item" ? "active" : "")">
                                    <a asp-controller="Item" asp-action="Index" class="item-link">Shop</a>
                                </li>
                                <li class="menu-item">
                                    <a href="javascript:void(0)" class="item-link">
                                        Categories
                                        <i class="icon icon-arrow-angle-down"></i>
                                    </a>
                                    <div class="sub-menu mega-menu mega-menu-product">
                                        <div class="container-layout-right">
                                            <div class="mega-menu-wrap">
                                                <div class="wrapper-sub-menu">
                                                    <div class="mega-menu-item">
                                                        <p class="text-caption menu-heading">PRODUCTS</p>
                                                        <ul class="menu-list">
                                                            @foreach (var product in navFeaturedProducts)
                                                            {
                                                                <li>
                                                                    <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@product.StyleCode" class="menu-link-text link">@product.ItemName</a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                    <div class="mega-menu-item">
                                                        <p class="text-caption menu-heading">CATEGORIES</p>
                                                        <ul class="menu-list">
                                                            @foreach (var category in navCategories)
                                                            {
                                                                <li><a asp-controller="Item" asp-action="Index" asp-route-categoryIds="@category.CategoryId" class="menu-link-text link">@category.CategoryName</a></li>
                                                            }
                                                        </ul>
                                                    </div>
                                                    <div class="mega-menu-item">
                                                        <p class="text-caption menu-heading">NEW ARRIVALS</p>
                                                        <ul class="menu-list">
                                                            @foreach (var product in navNewArrivals)
                                                            {
                                                                <li>
                                                                    <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@product.StyleCode" class="menu-link-text link">@product.ItemName</a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                    <div class="mega-menu-item">
                                                        <p class="text-caption menu-heading">BRANDS</p>
                                                        <ul class="menu-list">
                                                            @foreach (var brand in navBrands)
                                                            {
                                                                <li>
                                                                    <a asp-controller="Item" asp-action="Index" asp-route-brandIds="@brand.BrandId" class="menu-link-text link">@brand.BrandType</a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                                <div class="wrapper-sub-collection">
                                                    @foreach (var product in navFeaturedProducts.Take(2))
                                                    {
                                                        <div class="card_product--V01">
                                                            <div class="card_product-wrapper aspect-ratio-1">
                                                                <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@product.StyleCode" class="product-img">
                                                                    @{
                                                                        var primaryImg = product.PrimaryImageUrl;
                                                                        var primaryImgUrl = string.IsNullOrEmpty(primaryImg) ? "/app/images/products/product-28.jpg" : (primaryImg.StartsWith("/") ? primaryImg : "/" + primaryImg);
                                                                        var secondaryImg = product.SecondaryImageUrl;
                                                                        var secondaryImgUrl = string.IsNullOrEmpty(secondaryImg) ? primaryImgUrl : (secondaryImg.StartsWith("/") ? secondaryImg : "/" + secondaryImg);
                                                                    }
                                                                    <img src="@primaryImgUrl" data-src="@primaryImgUrl" alt="@product.ItemName" class="lazyload img-product">
                                                                    <img src="@secondaryImgUrl" data-src="@secondaryImgUrl" alt="@product.ItemName" class="lazyload img-hover">
                                                                </a>
                                                            </div>
                                                            <div class="card_product-info">
                                                                <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@product.StyleCode" class="name-product h5 fw-normal link text-line-clamp-2">
                                                                    @product.ItemName
                                                                </a>
                                                                <div class="price-wrap">
                                                                    <span class="price-new h5">@product.SellingPrice.ToString("C")</span>
                                                                    @if (product.DiscountPercentage > 0)
                                                                    {
                                                                        <span class="price-old fw-normal">@product.MRP.ToString("C")</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                <li class="menu-item @(currentController == "Home" && currentAction == "Learn" ? "active" : "")">
                                    <a href="@Url.Action("Learn", "Home")" class="item-link">
                                        Learn
                                    </a>
                                </li>
                                <li class="menu-item @(currentController == "Home" && currentAction == "AboutUs" ? "active" : "")">
                                    <a asp-controller="Home" asp-action="AboutUs" class="item-link">
                                        About Us
                                    </a>
                                </li>
                                <li class="menu-item position-relative @(currentController == "Home" && currentAction == "ContactUs" ? "active" : "")">
                                    <a asp-controller="Home" asp-action="ContactUs" class="item-link">
                                        Contact Us
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                    <div class="col-xl-2 col-md-4 col-3">
                        <ul class="nav-icon">
                            <li class="d-inline-flex">
                                <a href="#search" data-bs-toggle="offcanvas" class="nav-icon-item text-black link">
                                    <i class="icon icon-search"></i>
                                </a>
                            </li>
                            <li class="br-line d-none d-xl-flex"></li>
                            <li class="d-none d-md-inline-flex">
                                <partial name="_AuthPartial" />
                            </li>
                            <li class="d-none d-md-inline-flex" id="wishlist-indicator-container">
                                <partial name="~/Views/Wishlist/_WishlistIndicatorPartial.cshtml" model="wishCount" />
                            </li>
                            <li class="d-inline-flex" id="cart-indicator-container">
                                <partial name="~/Views/Cart/_CartIndicatorPartial.cshtml" model="cartCount" />
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>
        <!-- /Header -->

        <!-- Body -->
            <div class="container mt-3">
                @* <partial name="_FeedbackMessage" /> *@
                <div id="js-feedback-container"></div>
            </div>
            @RenderBody()
        <!-- /Body -->

        <!-- Footer -->
        <footer class="tf-footer">
            <div class="footer-top">
                <div class="container">
                    <ul class="category-list justify-content-xl-center">
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">New Collection</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">All Jewelry</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">Charms</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">Bracelets</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">Rings</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">Earrings</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">Gifts</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Item" asp-action="Index" class="tf-btn btn-line has-icon link">
                                <span class="text h6 text-uppercase fw-normal">Collections</span>
                                <i class="icon icon-arrow-top-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="footer-body p-xl-0">
                <div class="container">
                    <div class="row-footer">
                        <div class="col-s1">
                            <div class="footer-inner-wrap flex-lg-nowrap align-items-end">
                                <div class="box-title">
                                    <h6>JOIN THE <span class="text-primary">#YASH</span> TRIBE</h6>
                                    <p class="notice font-2">
                                        <span class="fst-italic">Shiny Things</span>
