    <!-- Reset Password -->
    <div class="offcanvas offcanvas-end canvas-sidebar" id="reset">
        <div class="canvas-header">
            <h3 class="title fw-normal text-uppercase">Reset password</h3>
            <span class="icon-close link icon-close-popup" data-bs-dismiss="offcanvas"></span>
        </div>
        <div class="canvas-body">
            <p class="sub-title text-main-4">
                Please enter your registered email address to receive an email to reset
                your password
            </p>
            <form class="form-reset" id="resetForm" method="post">
                @Html.AntiForgeryToken()
                <div class="form-content">
                    <fieldset class="tf-field">
                        <input class="tf-input" type="email" name="Input.Email" placeholder="Enter your email" required>
                        <label class="tf-lable">Email *</label>
                    </fieldset>
                </div>
                <div id="reset-error" class="feedback-message error"></div>
                <div id="reset-success" class="feedback-message success"></div>
                <button type="submit" class="tf-btn btn-fill w-100 fw-medium animate-btn">
                    SUBMIT
                </button>
            </form>
        </div>
    </div>
    <!-- /Reset Password -->
    <!-- Shopping Cart -->
    <div class="offcanvas offcanvas-end popup-shopping-cart" id="shoppingCart">
        <div class="canvas-wrapper">
            @{
                var cartModel = await CartService.GetCartAsync(userId, guestId);
            }
            <partial name="~/Views/Cart/_CartSidebarPartial.cshtml" model="cartModel" />
        </div>
    </div>
    <!-- /Shopping Cart -->
    <!-- Search -->
    <div class="offcanvas offcanvas-top offcanvas-search" id="search">
        <div class="offcanvas-content">
            <div class="container">
                <div class="popup-content">
                    <form class="form-search" action="/Item" method="get">
                        <fieldset>
                            <input type="text" placeholder="ENTER YOUR SEARCH" class="" name="searchQuery" tabindex="0" value="" aria-required="true"
                                   required="">
                        </fieldset>
                        <button type="submit" class="link"><i class="icon icon-search"></i></button>
                        <span class="icon-close-popup" data-bs-dismiss="offcanvas">
                            <i class="icon-close"></i>
                        </span>
                    </form>
                    <div class="tf-grid-layout sm-col-2">
                        @{
                            var searchCategories = await LayoutService.GetCategoriesAsync(5);
                            var featuredProducts = await LayoutService.GetFeaturedProductsAsync(2);
                        }
                        
                        <div class="feature-wrap">
                            <p class="title">QUICK LINK</p>
                            <ul class="quick-link-list">
                                @if (searchCategories.Any())
                                {
                                    @foreach (var cat in searchCategories)
                                    {
                                        <li>
                                            <a asp-controller="Item" asp-action="Index" asp-route-categoryIds="@cat.CategoryId" class="link-item text-main-4 link">@cat.CategoryName</a>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li><p class="text-caption text-main-4">No categories found.</p></li>
                                }
                            </ul>
                        </div>
                        <div class="feature-wrap">
                            <p class="title">SUGGESTION FOR YOU</p>
                            <ul class="product-list">
                                @if (featuredProducts.Any())
                                {
                                    @foreach (var item in featuredProducts)
                                    {
                                        <li>
                                            <div class="tf-product-mini-view">
                                                <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="prd-image">
                                                    <img src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/uploads/default.png" : (item.PrimaryImageUrl.StartsWith("/") ? item.PrimaryImageUrl : "/" + item.PrimaryImageUrl))" alt="@item.ItemName">
                                                </a>
                                                <div class="prd-content">
                                                    <a asp-controller="Item" asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="prd-name link text-uppercase">
                                                        @item.ItemName
                                                    </a>
                                                    <div class="price-wrap">
                                                        <span class="price-new @(item.DiscountPercentage > 0 ? "price-on-sale" : "")">
                                                            @item.SellingPrice.ToString("C")
                                                        </span>
                                                        @if (item.DiscountPercentage > 0)
                                                        {
                                                            <span class="price-old compare-at-price text-caption">@item.MRP.ToString("C")</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li><p class="text-caption text-main-4">No suggestions available.</p></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <span class="close" data-bs-dismiss="offcanvas"></span>
    </div>
    <!-- /Search -->
    <!-- Quick View -->
