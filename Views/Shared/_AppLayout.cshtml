            <a asp-controller="Wishlist" asp-action="Index">
                <span class="toolbar-icon">
                    <i class="icon icon-hearth-3"></i>
                    <span class="toolbar-count wishlist-count">@wishCount</span>
                </span>
                <span class="toolbar-label">Wishlist</span>
            </a>
        </div>
        <div class="toolbar-item">
            <a href="#shoppingCart" data-bs-toggle="offcanvas">
                <span class="toolbar-icon">
                    <i class="icon icon-cart"></i>
                    <span class="toolbar-count cart-count">@cartCount</span>
                </span>
                <span class="toolbar-label">Cart</span>
            </a>
        </div>
    </div>
    <!-- /Toolbar -->
    <!-- Javascript -->
    <script src="/app/js/bootstrap.min.js"></script>
    <script src="/app/js/jquery.min.js"></script>
    <script src="/app/js/swiper-bundle.min.js"></script>
    <script src="/app/js/carousel.js"></script>
    <script src="/app/js/bootstrap-select.min.js"></script>
    <script src="/app/js/lazysize.min.js"></script>
    <script src="/app/js/infinityslide.js"></script>
    <script src="/app/js/gsap.min.js"></script>
    <script src="/app/js/ScrollTrigger.min.js"></script>
    <script src="/app/js/SplitText.min.js"></script>
    <script src="/app/js/parallaxie.js"></script>
    <script src="/app/js/count-down.js"></script>
    <script src="/app/js/wow.min.js"></script>
    <script src="/app/js/main.js"></script>
    <script src="/app/js/cart.js"></script>
    <script src="/app/js/site.js"></script>
    <script src="/app/js/zoom.js"></script>
    <script src="/app/js/photoswipe-lightbox.umd.min.js"></script>
    <script src="/app/js/photoswipe.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Function to handle form submission via AJAX
            async function handleAuthFormSubmission(formId, endpoint, errorId, successId) {
                const form = document.getElementById(formId);
                const errorDiv = document.getElementById(errorId);
                const successDiv = successId ? document.getElementById(successId) : null;

                if (!form) return;

                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    if (errorDiv) errorDiv.style.display = 'none';
                    if (successDiv) successDiv.style.display = 'none';

                    const formData = new FormData(form);
                    
                    try {
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            body: formData
                        });
                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }
                        if (response.ok) {
                            const result = await response.json();
                            if (result.success) {
                                if (successDiv) {
                                    successDiv.textContent = 'Action successful! Please check your email if required.';
                                    successDiv.style.display = 'block';
                                    form.reset();
                                }
                                if (result.redirectUrl) {
                                    window.location.href = result.redirectUrl;
                                } else {
                                    window.location.reload();
                                }
                            } else {
                                if (errorDiv) {
                                    if (result.errors && Array.isArray(result.errors)) {
                                        errorDiv.innerHTML = '<ul>' + result.errors.map(e => `<li>${e}</li>`).join('') + '</ul>';
                                    } else {
                                        errorDiv.textContent = result.message || 'An error occurred. Please try again.';
                                    }
                                    errorDiv.style.display = 'block';
                                }
                            }
                        } else {
                            // Fallback for non-JSON responses
                            if (errorDiv) {
                                errorDiv.textContent = 'An unexpected server error occurred. Please try again later.';
                                errorDiv.style.display = 'block';
                            }
                        }
                    } catch (err) {
                        console.error('Auth request failed:', err);
                        if (errorDiv) {
                            errorDiv.textContent = 'Connection error. Please try again later.';
                            errorDiv.style.display = 'block';
                        }
                    }
                });
            }

            // Wire up the forms
            handleAuthFormSubmission('loginForm', '/Account/Login', 'login-error');
            handleAuthFormSubmission('registerForm', '/Account/Register', 'register-error', 'register-success');
            handleAuthFormSubmission('resetForm', '/Account/ForgotPassword', 'reset-error', 'reset-success');

            // Handle modal auto-trigger from URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const modalTrigger = urlParams.get('modal');
            if (modalTrigger === 'login') {
                const loginModal = new bootstrap.Modal(document.getElementById('log'));
                loginModal.show();
            } else if (modalTrigger === 'register') {
                const registerModal = new bootstrap.Modal(document.getElementById('register'));
                registerModal.show();
            }
            // Quick View Logic
            $(document).on('click', '.quickview', function(e) {
                e.preventDefault();
                var styleCode = $(this).data('stylecode');
                var modalEl = document.getElementById('quickView');
                var $modalDialog = $(modalEl).find('.modal-dialog');
                
                // Show loading state
                $modalDialog.html('<div class="modal-content"><div class="modal-body text-center p-5"><div class="spinner-border text-primary" role="status"></div></div></div>');
                
                // Use Bootstrap 5 API
                var myModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                myModal.show();

                $.ajax({
                    url: '/Item/QuickView/' + styleCode,
                    type: 'GET',
                    success: function(html) {
                        $modalDialog.html(html);
                        
                        // Initialize Swiper for the modal images
                        if (typeof Swiper !== 'undefined') {
                            var swiperEl = $(modalEl).find('.tf-single-slide')[0];
                            if (swiperEl) {
                                new Swiper(swiperEl, {
                                    slidesPerView: 1,
                                    spaceBetween: 10,
                                    navigation: {
                                        nextEl: '.single-slide-next',
                                        prevEl: '.single-slide-prev',
                                    },
                                });
                            }
                        }
                        
                        // Set initial price on Add to Bag button
                        updateQuickViewPrice();
                    },
                    error: function() {
                        $modalDialog.html('<div class="modal-content"><div class="modal-body text-center p-5 text-danger"><p>Failed to load product details.</p><button type="button" class="btn btn-secondary mt-3" data-bs-dismiss="modal">Close</button></div></div>');
                    }
                });
            });

            // Cleanup for QuickView
            $('#quickView').on('hidden.bs.modal', function () {
                $(this).find('.modal-dialog').empty();
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
            });

            // Quick View Quantity & Price Logic
            $(document).on('click', '#quickView .btn-increase', function() {
                var $input = $(this).siblings('.quantity-product');
                var val = parseInt($input.val()) || 1;
                $input.val(val + 1);
                updateQuickViewPrice();
            });

            $(document).on('click', '#quickView .btn-decrease', function() {
                var $input = $(this).siblings('.quantity-product');
                var val = parseInt($input.val()) || 1;
                if (val > 1) {
                    $input.val(val - 1);
                    updateQuickViewPrice();
                }
            });

            $(document).on('change', '#quickView .quantity-product', function() {
                updateQuickViewPrice();
            });

            function updateQuickViewPrice() {
                var $modal = $('#quickView');
                var $addBtn = $modal.find('.btn-add-to-cart');
                if (!$addBtn.length) return;

                var unitPrice = parseFloat($addBtn.data('unit-price')) || 0;
                var qty = parseInt($modal.find('.quantity-product').val()) || 1;
                var total = unitPrice * qty;
                
                // Detect currency symbol from the main price display in modal
                var priceText = $modal.find('.price-new').first().text() || "$0";
                var symbol = priceText.match(/[^\d,.\s]/g); 
                symbol = (symbol && symbol.length > 0) ? symbol[0] : '$';

                var formatted = total.toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });

                $modal.find('.price-add').text(symbol + formatted);
            }

            $(document).on('click', '.btn-buy-now', function() {
                const styleCode = $(this).data('stylecode');
                const quantity = $('#quickView .quantity-product').val() || 1;
                if (!styleCode) return;
                // Add to cart and then redirect to checkout
                $.ajax({
                    url: '/Cart/AddToCart',
                    type: 'POST',
                    data: { styleCode: styleCode, quantity: quantity },
                    success: function (response) {
                        if (response.success) {
                            window.location.href = '/Checkout';
                        } else {
                            alert(response.message);
                        }
                    }
                });
            });

            // Newsletter Subscription AJAX
            $('#newsletter-form').on('submit', function(e) {
                e.preventDefault();
                const $form = $(this);
                const $btn = $form.find('button[type="submit"]');
                const email = $form.find('input[name="email"]').val();

                if (!email) return;

                $btn.prop('disabled', true);

                $.ajax({
                    url: '/Newsletter/Subscribe',
                    type: 'POST',
                    data: {
                        email: email,
                        __RequestVerificationToken: $form.find('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        $form.find('.feedback-message').remove();
                        const statusClass = response.success ? 'success' : 'error';
                        const feedbackHtml = `<div class="feedback-message ${statusClass}">${response.message}</div>`;
                        $form.find('fieldset').after(feedbackHtml);

                        if (response.success) {
                            $form.find('input[name="email"]').val('');
                            setTimeout(() => $form.find('.feedback-message').fadeOut(), 5000);
                        }
                    },
                    error: function() {
                        $form.find('.feedback-message').remove();
                        $form.find('fieldset').after('<div class="feedback-message error">An error occurred. Please try again.</div>');
                    },
                    complete: function() {
                        $btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
